// HFMC — Mortgage Case Tracker. Relational schema (an upgrade from the
// original single-JSON-blob model acknowledged in the source as a future step).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      String // designation label, e.g. "Mortgage Head"
  team      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  ownedCases      LoanCase[]      @relation("CaseOwner")
  createdTasks    Task[]          @relation("TaskCreator")
  assignedTasks   Task[]          @relation("TaskAssignee")
  activities      Activity[]
  issuedInstructions Instruction[] @relation("InstrIssuer")
  assignedInstructions Instruction[] @relation("InstrAssignee")
  issuedBulletins  BulletinItem[]  @relation("BulletinIssuer")
  bulletins        BulletinTarget[]
  bulletinReplies  Reply[]         @relation("ReplyUser")
  instructionReplies InstrReply[]  @relation("InstrReplyUser")
  affordabilityChecks AffordabilityCheck[]
  sessions         Session[]
  stageTransitions StageTransition[]
  vrmCases         LoanCase[] @relation("CaseVrm")
}

model Designation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  scope     String   // "all" | "team" | "own"
  issueTasks Boolean @default(false)
  admin     Boolean  @default(false)
  super     Boolean  @default(false)
  viewRevenue Boolean @default(false) // commission rates & earnings are restricted
  builtIn  Boolean  @default(false)
}

model LoanCase {
  id          Int      @id @default(autoincrement())
  caseNumber  String   @unique
  customer    String
  banks       String   @default("[]") // JSON array of bank names
  wonBank     String?
  loanAmount  Int
  stage       String
  caseStatus  String   @default("Active") // Active | Closed | Lost
  closedDate  String?
  ownerId     Int
  source      String   @default("Direct") // Direct | Agent | Broker | Website | Referral
  partnerKind String?  // Agent | Broker | Referral
  partnerName String?
  partnerSharePct Int?
  // Two-way commission: submission type (direct to bank vs through channel)
  submissionType String  @default("direct") // direct | channel
  channelId      Int?
  channelName    String?   // denormalized for history
  channelRatePct Float   @default(0)  // channel's cut as % of loan amount (e.g. 0.4)
  whatsapp    String   @default("")
  waGroup     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Document Vault profile vectors — drive the conditional checklist ---
  employmentProfile String @default("Salaried") // Salaried | Self-Employed | Non-Resident
  propertyType      String @default("Ready")    // Ready | Off-Plan
  residency         String @default("Resident Expatriate") // UAE National | Resident Expatriate | Non-Resident

  // --- MIS operational fields (feed the client portal + daily updates) ---
  statusNote       String  @default("") // daily free-text status narrative shown to the client
  bankRm           String? // bank relationship manager name
  vrmId            Int?    // internal VRM handling the file (maker), distinct from the owner
  transactionType  String  @default("") // Buyout, Primary Handover, Resale, Equity Release…
  propertyLocation String? // Dubai, Abu Dhabi, ADGM…
  coApplicantName  String?
  onHold           Boolean @default(false)
  holdReason       String?
  holdUntil        String? // ISO date
  // --- Bank submission tracking ---
  loanType          String? // NSTL | STL (non-salary vs salary transfer)
  fileSubmittedDate String? // when the file was submitted to the bank
  bankRate          Float?  // rate the bank quoted
  bankTenor         Int?    // tenor the bank approved (months)
  // --- Pre-approval stage capture ---
  preApprovalDate   String?
  preApprovalAmount Int?
  preApprovalTenure Int?
  preApprovalRoi    Float?
  // --- Final Offer Letter capture ---
  folDate   String?
  folAmount Int?
  folTenure Int?
  folRoi    Float?

  owner      User      @relation("CaseOwner", fields: [ownerId], references: [id])
  vrm        User?     @relation("CaseVrm", fields: [vrmId], references: [id])
  tasks      Task[]
  activities Activity[]
  instructions Instruction[]
  bulletins  BulletinItem[]
  emails     EmailLog[]
  stageTransitions StageTransition[]
  clientDocuments  ClientDocument[]
  clientSessions   ClientSession[]
  vaultDocuments   CaseDocument[]
}

model Task {
  id          Int      @id @default(autoincrement())
  caseId      Int
  description String
  ownerId     Int
  createdBy   Int
  waitingFor  String
  whyPending  String
  createdAt   DateTime @default(now())
  dueDate     String
  status      String   @default("Open") // Open | Done
  completedAt DateTime?
  remarks     String   @default("")

  case     LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  owner    User     @relation("TaskAssignee", fields: [ownerId], references: [id])
  creator  User     @relation("TaskCreator", fields: [createdBy], references: [id])
}

model Activity {
  id        Int      @id @default(autoincrement())
  caseId    Int
  userId    Int
  at        DateTime @default(now())
  action    String
  oldValue  String?
  newValue  String?

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id])
}

model Instruction {
  id          Int      @id @default(autoincrement())
  caseId      Int
  issuedBy    Int
  instruction String
  assignedTo  Int
  dueDate     String
  status      String   @default("Open")
  createdAt   DateTime @default(now())
  completedAt DateTime?

  case     LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  issuer   User     @relation("InstrIssuer", fields: [issuedBy], references: [id])
  assignee User     @relation("InstrAssignee", fields: [assignedTo], references: [id])
  replies  InstrReply[]
}

model InstrReply {
  id            Int      @id @default(autoincrement())
  instructionId Int
  userId        Int
  text          String
  at            DateTime @default(now())

  instruction Instruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  user        User         @relation("InstrReplyUser", fields: [userId], references: [id])
}

model BulletinItem {
  id           Int      @id @default(autoincrement())
  date         String   // ISO date this directive belongs to
  issuedBy     Int
  task         String
  caseId       Int?
  status       String   @default("Open")
  completedAt  DateTime?
  completedBy  Int?
  createdAt    DateTime @default(now())
  carriedFrom  String?
  dropped      Boolean  @default(false)
  templateId   Int?
  isTemplate   Boolean  @default(false)
  repeat       String?  // none | daily | weekdays

  issuer    User             @relation("BulletinIssuer", fields: [issuedBy], references: [id])
  targets   BulletinTarget[]
  replies   Reply[]
  case      LoanCase?        @relation(fields: [caseId], references: [id])
}

model BulletinTarget {
  id          Int @id @default(autoincrement())
  bulletinId  Int
  userId      Int

  bulletin BulletinItem @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])
}

model Reply {
  id          Int      @id @default(autoincrement())
  bulletinId  Int
  userId      Int
  text        String
  at          DateTime @default(now())

  bulletin BulletinItem @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  user     User          @relation("ReplyUser", fields: [userId], references: [id])
}

model StageItem {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
}

model MasterItem {
  id        Int      @id @default(autoincrement())
  kind      String   // "whyPending" | "waitingFor"
  label     String
  active    Boolean  @default(true)

  @@unique([kind, label])
}

model BankItem {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  ratePct   Float   @default(0)
  active    Boolean @default(true)
  // professional profile
  logoData  Bytes?
  logoType  String?
  posPoints String  @default("") // negotiating intel — positives
  negPoints String  @default("") // negotiating intel — negatives
  website   String?

  products BankProduct[]
}

// Bank rule product — one row per (bank x segment x product kind), decoded from
// the rates/policy workbooks. Typed headline fields feed the eligibility engine;
// axesJson keeps every raw axis verbatim. Versioned: imports create new versions,
// humans approve them (status draft → approved).
model BankProduct {
  id        Int     @id @default(autoincrement())
  bankId    Int
  name      String  // e.g. "Salaried · Conventional"
  sheet     String  // source sheet: Salaried | Self Employed | NR | Commercial Property | Low Doc
  employment String // Salaried | Self-Employed | Salaried or Self-Employed
  residency String  // Resident | Non-Resident
  financeType String @default("Residential") // Residential | Commercial
  program   String  @default("") // e.g. Low-Doc
  loanKind  String  @default("") // Conventional | Islamic | mixed

  // typed headline fields (parsed from axes — engine inputs)
  maxLtvNational    Int?
  maxLtvExpatriate  Int?
  minLoan           Int?
  maxLoan           Int?
  tenorYears        Int?
  minSalary         Int?
  totalTatDays      Int?
  paTatDays         Int?
  paValidityDays    Int?
  folValidityDays   Int?
  valuationValidityDays Int?
  pricingJson       String @default("{}") // structured rate quotes (see lib/bank-pricing.ts)
  rateTable         String @default("") // segmented pricing text (fixed/variable/buyout/equity)
  stressTest        String @default("")
  fees              String @default("")
  insurance         String @default("")
  eligibility       String @default("") // min salary/service/bonus/rental notes
  documents         String @default("")
  notes             String @default("")
  axesJson          String @default("{}") // full raw axes, verbatim

  // versioning workflow
  version      Int    @default(1)
  status       String @default("approved") // draft | approved
  effectiveDate String?
  approvedBy   String?
  sourceFiles  String @default("")
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bank BankItem @relation(fields: [bankId], references: [id], onDelete: Cascade)
}

// Current EIBOR benchmark rates — variable/stress formulas reference these live,
// so a quarterly update here reprices every bank correctly.
model EiborRate {
  tenor    String @id // 1M | 3M | 6M | 1Y
  ratePct  Float
  updatedOn String @default("")
  note     String @default("")
}

model PartnerItem {
  id                Int      @id @default(autoincrement())
  kind              String   // Agent | Broker | Referral
  name              String
  defaultSharePct   Int      @default(20)
  password          String   @default("agent123") // agent portal login
  active            Boolean  @default(true)

  @@unique([kind, name])
}

model SlaRule {
  id        Int      @id @default(autoincrement())
  stage     String
  bank      String? // null = all banks
  maxDays   Int
  active    Boolean  @default(true)
}

model AffordabilityCheck {
  id               Int      @id @default(autoincrement())
  caseId           Int?
  customerName     String
  monthlyIncome    Int
  otherIncome      Int      @default(0)
  existingEmis     Int      @default(0)
  age              Int
  employmentType   String   // Salaried | Self-Employed
  propertyValue    Int
  bank             String
  interestRate     Float?
  tenureYears     Int?
  applicableLtv    Float
  maxLoanByLtv     Int
  maxDbrPct        Float
  availableDbrEmi  Int
  maxLoanByDbr     Int
  maxTenureByAge   Int
  finalEligibleLoan Int
  estimatedEmi     Int
  eligible         Boolean
  createdBy        Int
  createdAt        DateTime @default(now())
  payload          String?  // JSON snapshot of full mortgage input

  creator User @relation(fields: [createdBy], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

// Matched email — linked to a case, shown as a timeline entry on Case 360.
// Deliberately no body stored — just enough to know it happened + a deep link
// back to Outlook so the case officer can open the original.
model EmailLog {
  id          Int      @id @default(autoincrement())
  caseId      Int
  subject     String
  sender      String
  direction   String   @default("from_bank") // from_bank | from_client | internal
  receivedAt DateTime @default(now())
  outlookLink String?
  messageId   String?  @unique // dedup key from the inbound webhook

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// Unmatched email — fuzzy match wasn't confident enough to auto-link.
// Waits in a review queue until a human confirms, picks a different case, or ignores.
model UnmatchedEmail {
  id              Int       @id @default(autoincrement())
  subject         String
  sender          String
  receivedAt      DateTime  @default(now())
  bestGuessCaseId Int?
  status          String    @default("Pending") // Pending | Linked | Ignored
  messageId       String?   @unique
  resolvedBy      Int?
  resolvedAt      DateTime?
}


// Channel partners (Huspy, Prypco, etc.) — platforms that submit deals
// to banks on your behalf and take a cut of the loan amount.
model ChannelItem {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  commissionPct Float    @default(0.4) // % of loan amount the channel takes
  active        Boolean  @default(true)
}

// Stage change log — powers the client portal timeline and the Case 360 history.
model StageTransition {
  id        Int      @id @default(autoincrement())
  caseId    Int
  fromStage String
  toStage   String
  comment   String   @default("")
  userId    Int
  at        DateTime @default(now())

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id])
}

// Client portal session — separate from team sessions.
// Clients log in with case number + last 4 digits of their phone, not a password.
model ClientSession {
  id        String   @id @default(cuid())
  caseId    Int
  phone     String
  createdAt DateTime @default(now())
  expiresAt DateTime
  case      LoanCase @relation(fields: [caseId], references: [id])
}

// Client-uploaded documents — metadata only; files live in storage/G-Drive.
model ClientDocument {
  id         Int      @id @default(autoincrement())
  caseId     Int
  fileName   String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
  case       LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// Document rule template — the master catalog behind the conditional Document
// Vault. Admin CRUD (Admin → Doc Rules). Conditions are JSON string arrays of
// allowed profile values; "all"/"any" match everything. Feeds per-case checklists.
model DocRule {
  id            Int     @id @default(autoincrement())
  code          String  @default("") // e.g. DOC-SAL-CERT
  name          String
  category      String  @default("KYC") // KYC | Income | Property | Bank & Liabilities | Internal Underwriting | Valuation | Transfer
  validityDays  Int     @default(0) // 0 = no fixed validity — rely on the note
  warnDays      Int     @default(7) // flag this many days before expiry
  verifyNotes   String  @default("") // what to check / rejection triggers
  // condition vectors (JSON arrays): "all"/"any" or specific values
  applicableEmployment   String @default("[\"all\"]")  // Salaried | Self-Employed | Non-Resident | all
  applicablePropertyType String @default("[\"any\"]")  // Ready | Off-Plan | any
  applicableTransaction  String @default("[\"any\"]")  // New Purchase | Buyout / Equity Release | any
  applicableResidency    String @default("[\"all\"]")  // UAE National | Resident Expatriate | Non-Resident | all
  // access rules
  mandatory           Boolean @default(true)  // blocks case progression when missing
  visibleToClient     Boolean @default(true)  // false = staff-internal only (AECB, memos…)
  clientCanUpload     Boolean @default(true)
  expiryTrackingRequired Boolean @default(true)
  active       Boolean @default(true)
}

// Per-case document instance — the living vault. Auto-populated from templates
// by the condition engine, plus ad-hoc additions; full CRUD on the case.
model CaseDocument {
  id              Int      @id @default(autoincrement())
  caseId          Int
  templateId      Int?     // null = ad-hoc document
  title           String
  category        String   @default("KYC")
  status          String   @default("Pending upload") // Pending upload | Uploaded | Verified | Rejected | Waived
  mandatory       Boolean  @default(true)
  visibleToClient Boolean  @default(true)
  clientCanUpload Boolean  @default(true)
  rejectionReason String   @default("")
  notes           String   @default("")
  fileName        String?
  fileType        String?
  fileSize        Int?
  fileData        Bytes?
  expiryDate      String?
  uploadedByKind  String   @default("") // client | staff
  uploadedById    Int?
  uploadedAt      DateTime?
  verifiedById    Int?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  sortOrder       Int      @default(0)

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// SOP §6.9 — Government & bank transfer fee matrices (Dubai / Abu Dhabi).
// Admin-managed (Admin → Fee rules); feeds the Calculator's Transfer Fees tab.
model FeeRule {
  id         Int     @id @default(autoincrement())
  emirate    String  // Dubai | Abu Dhabi
  txnType    String  // Primary | Resale | Buyout
  label      String
  amountType String  // pct_property | pct_loan | fixed
  amount     Float
  paidBy     String  @default("Client") // Client | Seller
  note       String  @default("")
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  @@index([emirate, txnType])
}
