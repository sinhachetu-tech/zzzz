// HFMC — Mortgage Case Tracker. Relational schema (an upgrade from the
// original single-JSON-blob model acknowledged in the source as a future step).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      String // designation label, e.g. "Mortgage Head"
  // OFFICE — where this person sits: Dubai / Abu Dhabi / Management. Deliberately
  // NOT the same thing as the department below, despite both once being called
  // "team". A person is ONE department in ONE office; pairing them into a single
  // "Dubai-Wills" value would need re-picking on every hire and would break the
  // moment someone moves office, which is routine.
  team      String
  // DEPARTMENT — what this person sells. `ServiceLine` IS the department (Mortgage,
  // Wills, Golden visa, …), so this needs no new table. Null = not yet assigned;
  // treated as "no department restriction" rather than as a denial, because a new
  // hire with no department set must not be locked out of everything on day one.
  //
  // NOT an access control: what a designation may TOUCH comes from
  // Designation.serviceLineIds, because one designation can span lines (Management)
  // while one user can in principle cover two. This field is informational
  // ("who works where", department rosters, head-of-department counts).
  serviceLineId Int?
  active    Boolean  @default(true)
  phone     String?  // WhatsApp / direct line — shown to clients (advisor card) and agents (desk card)
  // Microsoft Graph (delegated) tokens for send-mail-as-user
  graphAccessToken      String?
  graphRefreshToken     String?
  graphTokenExpiresAt   DateTime?
  graphConnectedAt      DateTime?
  createdAt DateTime @default(now())

  ownedCases      LoanCase[]      @relation("CaseOwner")
  advisedCases    LoanCase[]      @relation("CaseAdvisor")
  backupOneCases  LoanCase[]      @relation("CaseBackupOne")
  backupTwoCases  LoanCase[]      @relation("CaseBackupTwo")
  createdTasks    Task[]          @relation("TaskCreator")
  assignedTasks   Task[]          @relation("TaskAssignee")
  activities      Activity[]
  issuedInstructions Instruction[] @relation("InstrIssuer")
  assignedInstructions Instruction[] @relation("InstrAssignee")
  issuedBulletins  BulletinItem[]  @relation("BulletinIssuer")
  bulletins        BulletinTarget[]
  bulletinReplies  Reply[]         @relation("ReplyUser")
  instructionReplies InstrReply[]  @relation("InstrReplyUser")
  affordabilityChecks AffordabilityCheck[]
  sessions         Session[]
  stageTransitions StageTransition[]
  vrmCases         LoanCase[] @relation("CaseVrm")
  caseUpdateAuthors CaseUpdate[] @relation("CaseUpdateAuthor")
  proposals Proposal[] @relation("ProposalAuthor")
  sentChatMessages ChatMessage[]
  devices          UserDevice[]
  // staff who pressed "Convert to case" on a lead they were working
  conversions     LoanCase[]      @relation("CaseConverter")
  // staff who recorded a bank leg's outcome (Phase 2)
  decidedCases    LoanCase[]      @relation("CaseDecider")
  // staff who owns a Lead row / converted it into a case
  ownedLeads      Lead[]          @relation("LeadOwner")
  convertedLeads  Lead[]          @relation("LeadConverter")
  // internal staff-only group chat (Phase 4)
  createdRooms     StaffRoom[]         @relation("RoomCreator")
  staffRooms       StaffRoomMember[]
  sentStaffMessages StaffMessage[]
  // The one department this person works in (see serviceLineId above). Named
  // relation because ServiceLine ALSO points back at User via headUserId.
  serviceLine ServiceLine? @relation("UserDepartment", fields: [serviceLineId], references: [id])
  // Departments this person is head of (0 or 1 in practice, but the schema allows
  // several so a firm can run a joint head arrangement without a migration).
  headedDepartments ServiceLine[] @relation("DepartmentHead")
}

model Designation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  scope     String   // "all" | "team" | "own"
  // DEPARTMENT SCOPE — which service lines this designation may TOUCH. A JSON array
  // of ServiceLine CODES (["MORTGAGE","WILS_LEGAL"]), matching the convention of
  // DocRule.applicableBank rather than storing ids, because a code survives a
  // database rebuild and a backfill can reference it by name.
  //
  // EMPTY ARRAY = EVERY LINE. That default is what keeps all 17 existing
  // designations working untouched: nobody is locked out of anything by upgrading.
  //
  // This is READ-ACROSS, WRITE-LOCAL, enforced in visibleCases()/canEditCase() in
  // src/lib/domain.ts: a designation whose lines exclude MORTGAGE can still READ a
  // mortgage case belonging to a client it already touches (a will must account for
  // the debts on that file), but cannot EDIT it. Read-across without an edit lock
  // would be the same mistake as handing everyone the login.
  serviceLineIds String @default("[]")
  issueTasks Boolean @default(false)
  admin     Boolean  @default(false)
  super     Boolean  @default(false)
  viewRevenue Boolean @default(false) // commission rates & earnings are restricted
  editEibor Boolean  @default(false) // may update the daily EIBOR benchmark table
  manageDocs Boolean @default(true)  // may upload/verify/reject/waive/delete/compress vault documents
  clientChat Boolean @default(true)  // may reply to client & agent chats
  builtIn  Boolean  @default(false)
}

// SERVICE LINE — the kind of business we are in. The firm started as a mortgage
// brokerage but also does wills, insurance, real estate, business setup and
// golden-visa assistance, and the data model had NO way to say which. Everything
// downstream (stages, document rules, reporting, commissions) hangs off this
// one axis: a golden-visa case must never be forced through "Valuation".
//
// Deliberately a small table rather than an enum column: the service list is a
// business decision that will grow, and admin needs to add a line without a
// migration. `code` is the stable key used in code + backfills (MORTGAGE,
// GOLDEN_VISA, …); never rename a code, add a new one.
model ServiceLine {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  // short label for chips/pickers — "Mortgage", "Golden Visa"
  shortName String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  // does this line involve a per-bank competitive race (mortgage does; a will
  // does not)? Drives whether bank legs + legStatus are meaningful at all.
  bankRaced Boolean  @default(false)
  // DEPARTMENT HEAD — who to ask. INFORMATIONAL ONLY, never an access control:
  // access comes from Designation.serviceLineIds, because one designation can span
  // lines (Management sees everything) while one user can in principle cover two.
  // Kept separate from User.serviceLineId on purpose — "works in" and "runs" are
  // different facts, and a firm where the head also sells should be expressible.
  headUserId Int?
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  cases        LoanCase[]
  stageSets    StageSet[]
  docRules     DocRule[]
  slaRules     SlaRule[]
  commTemplates CommTemplate[]
  leads        Lead[]
  // documents this department has produced (Phase G). Ownership is provenance and is
  // NEVER rewritten when another department attaches the file to its own case.
  documents    ClientDocument[]

  // Who runs this department. Set-on-delete is RESTRICT (the default) rather than
  // SetNull on purpose: the schema does not choose, but a departing head should be
  // reassigned deliberately, and the backfill/apply path is reviewed SQL anyway.
  head     User?   @relation("DepartmentHead", fields: [headUserId], references: [id])
  staff    User[]  @relation("UserDepartment")

  @@index([active, sortOrder])
}

// PRODUCT — a specific offering WITHIN a service line. This is the layer that
// was missing and the one the old vocabulary conflated with the service line:
// "Mortgage" is a service line; "First-home purchase" / "Buyout & equity
// release" / "Construction" are products under it. A Case runs through exactly
// one product.
model Product {
  id            Int      @id @default(autoincrement())
  serviceLineId Int
  code          String   @unique
  name          String
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceLine ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Cascade)
  cases       LoanCase[]
  leads       Lead[]

  @@index([serviceLineId, active, sortOrder])
}

// LEAD — an expression of interest from someone we do not yet know well enough
// to commit a file to. Until Phase 4 lands, a "lead" is still a LoanCase row
// while stage === "Lead" (see the conversion stamp columns on LoanCase); this
// table is the destination for that migration.
//
// TWO DESIGN RULES worth preserving when this table starts being written to:
//   1. serviceLineId is REQUIRED. A consultancy selling six services cannot
//      answer "how many leads do we have?" without it — a golden-visa enquiry
//      and a 5M mortgage enquiry are otherwise the same row type and the
//      pipeline number is meaningless.
//   2. NEVER add service-specific columns here (no propertyValue, no salary,
//      no visaType). A lead knows who, how to reach them, what they want and
//      roughly how much. The moment this table grows a product-specific column,
//      it has become a Case in all but name.
model Lead {
  id            Int      @id @default(autoincrement())
  fullName      String
  phone         String   @default("") // digits only — match hint, never a merge key
  email         String?
  serviceLineId Int // REQUIRED — see rule 1 above
  productId     Int?     // null is valid: "doesn't know yet"
  intendedAmount Int?    // null is meaningful: "not stated"
  currency      String   @default("AED")
  source        String   @default("Direct") // Direct | Agent | Broker | Website | Referral | WalkIn
  // free-text detail the enum cannot hold: "met at GITEX stand", "WhatsApp ad"
  sourceDetail  String   @default("")
  status        String   @default("New") // New | Contacted | Qualified | Nurture | Converted | Lost | Invalid
  // Invalid is NOT the same as Lost: Lost = real interest that didn't convert
  // (price/timing/competitor). Invalid = spam, wrong number, duplicate. Mixing
  // them understates your conversion rate.
  ownerId       Int?     // nullable is NORMAL — an unassigned lead is not an error
  // A pointer, not a required FK: a lead may convert to a case before we know
  // the person well enough to make them a Client.
  clientId      Int?
  caseId        Int?     // set when the lead becomes a case
  lostReason    String   @default("")
  // The SLA clock starts HERE, not at createdAt. "Days since a human touched
  // it" is the metric a manager actually wants; createdAt measures arrival age
  // and would report a lead someone called on day 1 as stale by day 4.
  firstContactedAt DateTime?
  convertedAt   DateTime?
  convertedById Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner        User?     @relation("LeadOwner", fields: [ownerId], references: [id])
  convertedBy  User?     @relation("LeadConverter", fields: [convertedById], references: [id])
  serviceLine  ServiceLine @relation(fields: [serviceLineId], references: [id])
  product      Product?  @relation(fields: [productId], references: [id])
  client       Client?   @relation(fields: [clientId], references: [id])
  case         LoanCase? @relation("LeadOriginCase", fields: [caseId], references: [id])

  @@index([status, createdAt])
  @@index([serviceLineId, status])
  @@index([ownerId, status])
  @@index([phone])
}

// Client master — one row per human (borrower, co-borrower, co-applicant).
// The anchor for repeat business: every engagement (mortgage case today, a
// buyout in three years, an insurance policy after that) links back to the
// same person. Each case keeps its own profileJson snapshot as filed; this
// record holds the latest known truth, refreshed whenever a case profile is
// saved. Auto-merge key is the phone number only — name collisions never
// auto-merge (duplicates are cheap, wrong merges are not).
model Client {
  id        Int      @id @default(autoincrement())
  fullName  String
  // KYC identity — what actually decides "same person". EID is legally unique
  // in the UAE (definite auto-merge); passport is strong but renewable; phone
  // is only a hint (families share numbers) and never merges alone.
  eidNo     String?  @unique // Emirates ID, stored digits-only (784XXXXXXXXXXXX)
  passportNo String?
  phone     String   @default("") // digits only — match hint, never a sole merge key
  email     String?
  dob       String?
  nationality String?
  residency String   @default("Resident Expatriate")
  emirate   String?
  employmentProfile String @default("Salaried")
  companyName String?
  // latest-known financial snapshot (emptier profiles never erase these)
  monthlySalary   Int @default(0)
  variableIncome  Int @default(0)
  rentalIncome    Int @default(0)
  existingEmis    Int @default(0)
  creditCardLimits Int @default(0)
  // The reusable ANSWER SHEET — the ~50 facts bank application forms ask for
  // (mother's maiden name, home-country address, references, employment
  // breakdown, document validity windows…). It lives on the PERSON, not the case,
  // precisely so a returning customer is never asked the same question twice: a
  // renovation loan two years after the original purchase should start from what
  // we already know about that human.
  //
  // Deliberately a JSON blob rather than 50 columns: the field set is discovered
  // incrementally (every new bank form turns up something new), and the point of
  // src/lib/person-sheet.ts is that adding a field is ONE line there plus
  // whatever the new bank requires. The shape is declared in that file.
  //
  // `profileJson` on the case stays the "as filed" SNAPSHOT for one engagement;
  // this is the latest known truth — the same split as every other Client field.
  personJson  String  @default("{}")
  notes     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryCases     LoanCase[] @relation("PrimaryClient")
  secondPartyCases LoanCase[] @relation("SecondPartyClient")
  // every case this person is a party on, in any role (Phase A). This is the
  // relation that makes a co-borrower visible to their OWN person view —
  // secondPartyCases only covers the single legacy slot.
  caseParties      CaseParty[]
  // leads that resolved to this known person (Phase 4)
  leads            Lead[]
  // portal sessions for this person (Phase 3 — client-scoped, not case-scoped)
  clientSessions   ClientSession[]
  // their person-level document vault (Phase G). Files belong to the HUMAN, so they
  // survive every case: a passport uploaded for a mortgage is reused by the golden visa
  // and the will rather than re-uploaded three times.
  documents        ClientDocument[]

  @@index([phone])
  @@index([passportNo])
  // The Clients list searches by name and had no index for it — same sequential-scan
  // problem as LoanCase.customer.
  @@index([fullName])
}

// Phase A — the people ON a case, each in a role.
//
// THE RULE: the person is a Client, the role is on this link. Putting "CoBorrower"
// on the Client would make it look like a permanent fact about a human — it isn't.
// Ahmed's wife is a co-borrower on HFMC-0187; three years later she may be the
// primary on her own loan, or sign as a guarantor on someone else's, and none of
// that changes who she is.
//
// Why a table rather than more columns on LoanCase: `secondPartyClientId` is ONE
// slot. A real file has a primary, a co-borrower, sometimes two co-applicants and a
// guarantor. "secondParty2Id" was the wrong answer waiting to happen.
//
// The boundary that keeps this honest (would this still be true about Ahmed in
// three years, on a different service?):
//   Client  → demographics, KYC, contact, income, assets, liabilities
//   CaseParty → ONLY the role. Nothing about the person is duplicated here.
model CaseParty {
  id        Int      @id @default(autoincrement())
  caseId    Int
  clientId  Int
  role      String   @default("CoBorrower") // CoBorrower | CoApplicant | Guarantor
  // Display order within the case's party list. Separate from id so removing the
  // first co-applicant doesn't reshuffle everyone else's position.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  case   LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client Client   @relation(fields: [clientId], references: [id])

  // One person holds one role per case. Without this, "Add co-borrower" run twice
  // silently produces two rows for the same human on the same file, and the
  // KYC sheet double-counts them.
  @@unique([caseId, clientId])
  @@index([clientId])
  @@index([caseId, sortOrder])
}

model LoanCase {
  id          Int      @id @default(autoincrement())
  caseNumber  String   @unique
  customer    String
  banks       String   @default("[]") // JSON array of bank names
  wonBank     String?
  // --- Per-bank journey identity ---
  // The bank issues its OWN case / application number, which is not our
  // HFMC-xxxx and is quoted back to the bank on every follow-up. Because a
  // multi-bank deal is modelled as SIBLING cases (one LoanCase per bank — see
  // the perBank loop in api/cases/route.ts), this field is naturally per-bank:
  // the Mashreq leg carries Mashreq's reference, the Emirates leg theirs.
  bankRef     String?
  // Sibling linkage. The FIRST bank created is the parent (null); every bank
  // added afterwards points back at it, so the legs of one deal stay visibly
  // one deal instead of looking like unrelated cases in the worklist.
  parentCaseId Int?
  parentCase   LoanCase?  @relation("CaseSiblings", fields: [parentCaseId], references: [id])
  siblings     LoanCase[] @relation("CaseSiblings")
  loanAmount  Int
  // REAL property value. Was previously fabricated as loanAmount/0.8 in
  // case-profile.ts whenever this was absent, which invented an 80% LTV and fed
  // it to every LTV/affordability verdict. Null now means "not captured" and the
  // engine says so instead of guessing — see pricing-floor/trace work in
  // src/lib/bank-match.ts (resolveCaps returns boundBy).
  propertyValue Int?
  stage       String
  caseStatus  String   @default("Active") // Active | Closed | Lost
  closedDate  String?
  ownerId     Int
  source      String   @default("Direct") // Direct | Agent | Broker | Website | Referral
  partnerKind String?  // Agent | Broker | Referral
  partnerName String?
  partnerRm   String? // the partner's RM/coordinator handling this file
  partnerSharePct Int?
  // Two-way commission: submission type (direct to bank vs through channel)
  submissionType String  @default("direct") // direct | channel
  channelId      Int?
  channelName    String?   // denormalized for history
  channelRatePct Float   @default(0)  // channel's cut as % of loan amount (e.g. 0.4)
  whatsapp    String   @default("")
  waGroup     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Document Vault profile vectors — drive the conditional checklist ---
  employmentProfile String @default("Salaried") // Salaried | Self-Employed | Non-Resident (legacy display)
  propertyType      String @default("Ready")    // Ready | Off-Plan (legacy display only)
  residency         String @default("Resident Expatriate") // UAE National | Resident Expatriate | Non-Resident

  // --- FINAL PROPERTY CLASSIFICATION (canonical dims, additive, UNKNOWN-safe) ---
  // Stored separately from case stage/status: property stage describes the
  // PROPERTY; case stage describes the mortgage application. Ambiguous legacy
  // rows are backfilled to UNKNOWN/TO_VERIFY — never guessed. See
  // src/lib/case-profile.ts backfillCanonicalProperty for the mapping rules
  // (Off-plan NEVER implies Under-construction; Handover NEVER implies
  // construction Completed).
  propertyTypeCanonical  String  @default("UNKNOWN") // RESIDENTIAL | COMMERCIAL | UNKNOWN
  commercialSubtype      String?                     // OFFICE | RETAIL_SHOP | ... | UNKNOWN; NULL iff not COMMERCIAL
  propertyStage          String  @default("UNKNOWN") // OFF_PLAN | HANDOVER | COMPLETED | UNKNOWN
  constructionStatus     String  @default("UNKNOWN") // NOT_STARTED | UNDER_CONSTRUCTION | COMPLETED | UNKNOWN
  partyRelationship      String  @default("UNKNOWN") // DEVELOPER | EXISTING_OWNER | SELF | UNKNOWN
  existingFinance        String  @default("UNKNOWN") // NONE | MORTGAGE | UNKNOWN
  transactionPurpose     String  @default("UNKNOWN") // PURCHASE | REFINANCE | EQUITY_RELEASE | REFINANCE_AND_EQUITY | UNKNOWN

  // --- MIS operational fields (feed the client portal + daily updates) ---
  statusNote       String  @default("") // daily free-text status narrative shown to the client
  bankRm           String? // bank relationship manager name
  vrmId            Int?    // internal VRM handling the file (maker), distinct from the owner
  transactionType  String  @default("") // Buyout, Primary Handover, Resale, Equity Release…
  propertyLocation String? // Dubai, Abu Dhabi, ADGM…
  coApplicantName  String?
  profileJson      String  @default("{}") // structured primary applicant, property & co-borrower profile
  onHold           Boolean @default(false)
  holdReason       String?
  holdUntil        String? // ISO date
  lostReason       String? // why a lead/case was marked lost (audit trail — no hard delete for losses)
  // --- Lead → case conversion stamp ---
  // A "Lead" is not its own table; it is this row while stage === "Lead".
  // Converting moves the stage, and these two columns record THAT FACT so the
  // pipeline can distinguish "came from a lead on 12 Sep" from "manually
  // created on 12 Sep". Stamped once, on the PATCH where the stage first
  // leaves "Lead" — never re-stamped if the stage is later edited back and
  // forth, so it stays a stable date rather than a moving target.
  convertedAt   DateTime?
  convertedById Int?     // the user who pressed Convert
  // --- Bank submission tracking ---
  loanType          String? // NSTL | STL (non-salary vs salary transfer)
  fileSubmittedDate String? // when the file was submitted to the bank
  bankRate          Float?  // rate the bank quoted
  bankTenor         Int?    // tenor the bank approved (months)

  // --- Which RATE CARD priced this case (Phase 7) ---
  //
  // `banks` says WHICH bank; this says WHICH PRODUCT from that bank's sheet —
  // "Emirates Islamic · Salaried · Non-Resident · Low Doc" out of the 103-row
  // BankProduct catalogue. Without it a case records a bank but not the terms
  // that bank actually quoted, so when a bank reissues its sheet nobody can
  // answer "was this priced on v2 at 4.1%?".
  //
  // DELIBERATELY NOT `Product`. `Product` (service-line offerings: first-home,
  // buyout…) is a DIFFERENT axis — it describes the deal, not the rate. Mixing
  // them is what produced two competing vocabularies for one idea.
  //
  // One column, not a table, on purpose: a case is priced on ONE product at a
  // time. A BANK LEG (a child LoanCase via parentCaseId) carries its own value,
  // which is what lets a competitive race record a different rate card per bank
  // without inventing a rate-card-per-bank join table.
  //
  // Storing the id (not the rate) is the point: the RATE lives in
  // BankProduct.pricingJson and is versioned/effective-dated there, so a
  // quarterly sheet update repricing the catalogue does not rewrite history here.
  bankProductId Int?
  // Set only when this product is the one the client actually accepted. Kept
  // separate from bankProductId so "we quoted 4 options" and "they took 4.1%"
  // stay distinguishable — the same split Proposal.productIds records for quotes.
  bookedBankProductId Int?
  // --- Pre-approval stage capture ---
  preApprovalDate   String?
  preApprovalAmount Int?
  preApprovalTenure Int?
  preApprovalRoi    Float?
  // --- Final Offer Letter capture ---
  folDate   String?
  folAmount Int?
  folTenure Int?
  folRoi    Float?

  // --- Stage timeline (Case 360 drawer captures these directly; the stage
  // ticks read FIELDS first and only fall back to daily-note sniffing).
  // RULE: folConversionDate must be set before folSignedDate — the drawer
  // locks 4.4 signing until 4.1 conversion + 4.2 verification are on file.
  valuationInitiatedDate String? // stage 3 — valuation request sent to the bank
  inspectionDate         String? // stage 3 — inspection coordinated
  valuationReportDate    String? // stage 3 — report received (positive)
  folConversionDate      String? // stage 4 step 4.1 — conversion sent to banker
  folSignedDate          String? // stage 4 step 4.4 — client signed (never before conversion)
  ddaActive              Boolean @default(false) // stage 4 step 4.5 — DDA activated
  liabilityLetterDate    String? // stage 5 — liability letter received (resale w/ mortgage)
  settlementDate         String? // stage 5 — settlement/MC executed with the bank
  transferDate           String? // stage 5 — transfer appointment day
  titleDeedDate          String? // stage 5 — new Title Deed issued / QC done

  // --- Client master links (repeat business across engagements) ---
  clientId            Int? // primary applicant → Client
  secondPartyClientId Int? // co-borrower / co-applicant → their own Client row
  advisorId           Int? // the client-facing advisor (may differ from the owner who runs the file)
  backup1Id           Int? // first backup staffer — covers the file while the owner is on leave
  backup2Id           Int? // second backup staffer — covers the file while the owner is on leave
  profileClientVerifiedAt DateTime? // when the CLIENT last confirmed their own data sheet

  // --- SERVICE LINE (Phase 1) ---
  // Which line of business this procedure belongs to. Nullable so the additive
  // migration cannot fail on a locked/empty table; scripts/backfill-service-line
  // .mjs sets every existing row to MORTGAGE (factually true — every row today
  // is a mortgage). productId is the specific offering within that line.
  serviceLineId Int?
  productId     Int?

  // --- BANK LEG OUTCOME (Phase 2) ---
  // A multi-bank mortgage is a COMPETITIVE SET: many pre-approvals, one FOL, one
  // loan taken. `caseStatus` cannot express that — "Lost" means we lost the
  // business, which is not what happened to the Emirates leg when Mashreq won.
  // legStatus is per-leg; the parent row rolls up to Won when exactly one leg is.
  // Only meaningful when serviceLine.bankRaced is true.
  legStatus  String  @default("Active") // Active | Won | LostRace | Declined | Withdrawn
  decidedAt  DateTime? // when this leg's outcome was recorded
  decidedById Int?    // the user who recorded it

  owner      User      @relation("CaseOwner", fields: [ownerId], references: [id])
  advisor    User?     @relation("CaseAdvisor", fields: [advisorId], references: [id])
  backup1    User?     @relation("CaseBackupOne", fields: [backup1Id], references: [id])
  backup2    User?     @relation("CaseBackupTwo", fields: [backup2Id], references: [id])
  vrm        User?     @relation("CaseVrm", fields: [vrmId], references: [id])
  convertedBy User?    @relation("CaseConverter", fields: [convertedById], references: [id])
  decidedBy   User?    @relation("CaseDecider", fields: [decidedById], references: [id])
  serviceLine ServiceLine? @relation(fields: [serviceLineId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])
  originLeads Lead[]       @relation("LeadOriginCase")
  tasks      Task[]
  activities Activity[]
  instructions Instruction[]
  bulletins  BulletinItem[]
  emails     EmailLog[]
  stageTransitions StageTransition[]
  clientDocuments  ClientDocument[]
  clientSessions   ClientSession[]
  vaultDocuments   CaseDocument[]
  caseUpdates      CaseUpdate[]
  proposals        Proposal[]
  // Phase 7 — the rate card this case was quoted on / booked from.
  // Named because BankProduct already relates to several other models, so an
  // unnamed pair would be ambiguous to Prisma.
  // SetNull on delete: deleting a catalogue row must NOT delete the case that
  // was priced on it. The rate's history outlives the rate card.
  bankProduct       BankProduct? @relation("CaseRateCard", fields: [bankProductId], references: [id], onDelete: SetNull)
  bookedBankProduct BankProduct? @relation("CaseBookedRateCard", fields: [bookedBankProductId], references: [id], onDelete: SetNull)
  notificationOverrides String? // JSON override: { push?: boolean, whatsapp?: boolean, email?: boolean }
  dealExceptions   DealException[]
  chatMessages     ChatMessage[]
  devices          UserDevice[]
  client           Client?  @relation("PrimaryClient", fields: [clientId], references: [id])
  secondPartyClient Client? @relation("SecondPartyClient", fields: [secondPartyClientId], references: [id])
  // repeatable party list (Phase A). `secondPartyClientId` above stays exactly as
  // it is — one legacy slot, still read and written by client-master.ts — but it
  // can only ever hold ONE person. A case with two co-applicants plus a guarantor
  // is normal, so the full list lives here instead.
  caseParties       CaseParty[]
  // Admin-defined flexible stage data fields (Phase 3). Shape:
  // { [stageLabel: string]: { [fieldKey: string]: string | number | boolean | null } }
  // Existing typed columns (preApprovalDate, folDate, etc.) remain canonical for now;
  // admin-added fields for NEW stages land here so no migration is needed per field.
  stageDataJson    String  @default("{}")

  // --- Scale indexes (added for the 1,000-case question) ---------------------
  // `customer` is what the worklist searches on ("Search case / customer…") and it had
  // NO index, so name search was a sequential scan that worsens as the book grows.
  // `caseNumber` is already covered — it is @unique, which Postgres indexes.
  @@index([customer])
  // Phase F department scoping filters on serviceLineId on every /api/state request,
  // and the default worklist ordering is recency.
  @@index([serviceLineId, updatedAt])
}


model Task {
  id          Int      @id @default(autoincrement())
  caseId      Int
  description String
  ownerId     Int
  createdBy   Int
  waitingFor  String
  whyPending  String
  createdAt   DateTime @default(now())
  dueDate     String
  status      String   @default("Open") // Open | Done
  completedAt DateTime?
  remarks     String   @default("")

  case     LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  owner    User     @relation("TaskAssignee", fields: [ownerId], references: [id])
  creator  User     @relation("TaskCreator", fields: [createdBy], references: [id])
}

model Activity {
  id        Int      @id @default(autoincrement())
  caseId    Int
  userId    Int
  at        DateTime @default(now())
  action    String
  oldValue  String?
  newValue  String?

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id])
}

model Instruction {
  id          Int      @id @default(autoincrement())
  caseId      Int
  issuedBy    Int
  instruction String
  assignedTo  Int
  dueDate     String
  status      String   @default("Open")
  createdAt   DateTime @default(now())
  completedAt DateTime?

  case     LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  issuer   User     @relation("InstrIssuer", fields: [issuedBy], references: [id])
  assignee User     @relation("InstrAssignee", fields: [assignedTo], references: [id])
  replies  InstrReply[]
}

model InstrReply {
  id            Int      @id @default(autoincrement())
  instructionId Int
  userId        Int
  text          String
  at            DateTime @default(now())

  instruction Instruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  user        User         @relation("InstrReplyUser", fields: [userId], references: [id])
}

model BulletinItem {
  id           Int      @id @default(autoincrement())
  date         String   // ISO date this directive belongs to
  issuedBy     Int
  task         String
  caseId       Int?
  status       String   @default("Open")
  completedAt  DateTime?
  completedBy  Int?
  createdAt    DateTime @default(now())
  carriedFrom  String?
  dropped      Boolean  @default(false)
  templateId   Int?
  isTemplate   Boolean  @default(false)
  repeat       String?  // none | daily | weekdays

  issuer    User             @relation("BulletinIssuer", fields: [issuedBy], references: [id])
  targets   BulletinTarget[]
  replies   Reply[]
  case      LoanCase?        @relation(fields: [caseId], references: [id])
}

model BulletinTarget {
  id          Int @id @default(autoincrement())
  bulletinId  Int
  userId      Int

  bulletin BulletinItem @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])
}

model Reply {
  id          Int      @id @default(autoincrement())
  bulletinId  Int
  userId      Int
  text        String
  at          DateTime @default(now())

  bulletin BulletinItem @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  user     User          @relation("ReplyUser", fields: [userId], references: [id])
}

// STAGE SET — the stage list belonging to ONE service line. This is what lets a
// golden-visa case run Documents → Application → Visa issued → Emirates ID
// while a mortgage runs Document Collection → Pre-Approval → Valuation → FOL →
// Transfer. Before this, StageItem was global and the 5 mortgage stages were
// hardcoded in src/lib/workflow/registry.ts, so every case of every service had
// to walk the mortgage pipeline.
model StageSet {
  id            Int      @id @default(autoincrement())
  serviceLineId Int
  name          String
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  // null = the default set for that service line, used when a case names no set
  isDefault     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceLine ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Cascade)
  stages      StageItem[]

  @@unique([serviceLineId, name])
  @@index([serviceLineId, active])
}

model StageItem {
  id              Int         @id @default(autoincrement())
  label           String      @unique
  active          Boolean     @default(true)
  sortOrder       Int         @default(0)
  // Which service line this stage belongs to. NULL = legacy/global (the 5
  // mortgage stages before Phase 5); backfill-service-line.mjs assigns MORTGAGE.
  stageSetId      Int?
  // Admin-configurable behaviour (Phase 1 fields — no LoanCase migration needed)
  ownerRole       String      @default("")      // e.g. "VRM → SPO" shown on journey card
  exitGateSummary String      @default("")      // one-liner shown on the Move button when blocked
  sopJson         String      @default("[]")    // JSON string[] — procedure bullets admin writes
  commsJson       String      @default("[]")    // JSON string[] of CommTemplate keys for this stage

  stageSet StageSet? @relation(fields: [stageSetId], references: [id], onDelete: Cascade)
  steps StageStep[]
}

// Sub-steps / checklist for a stage — replaces the 5 hardcoded stages/*.ts files.
// Each row is one checkbox in the StageDrawer. `checkType` + `checkTarget` tell
// useStageLive how to evaluate it; `isGate` means "block stage advance if false".
model StageStep {
  id          Int      @id @default(autoincrement())
  stageId     Int
  stepNumber  String   @default("")    // display label, e.g. "2.3"
  label       String
  hint        String   @default("")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  isGate      Boolean  @default(false) // must pass (or override+reason) before advancing
  // How to evaluate this step automatically:
  // "date_field"    → ✓ when LoanCase[checkTarget] is non-null
  // "boolean_field" → ✓ when LoanCase[checkTarget] === true
  // "doc_category"  → ✓ when all mandatory docs of that category are Verified
  // "note_keyword"  → ✓ when any daily-note contains checkTarget (regex)
  // "manual"        → always false until staff ticks a StageStepAck row
  checkType   String   @default("manual") // date_field | boolean_field | doc_category | note_keyword | manual
  checkTarget String   @default("")       // field name on LoanCase or doc category or regex

  stage StageItem @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model MasterItem {
  id        Int      @id @default(autoincrement())
  kind      String   // "whyPending" | "waitingFor"
  label     String
  active    Boolean  @default(true)

  @@unique([kind, label])
}

model BankItem {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  ratePct   Float   @default(0)
  active    Boolean @default(true)
  // professional profile
  logoData  Bytes?
  logoType  String?
  posPoints String  @default("") // negotiating intel — positives
  negPoints String  @default("") // negotiating intel — negatives
  website   String?
  contactsJson String @default("[]") // bank RM contacts: [{name,phone,email,role}]

  // ---- BANK DEFAULTS -------------------------------------------------
  // The rarely-changing layer everything below inherits from. A product/slot that
  // sets its own value OVERRIDES these; a null field here means "use the norm"
  // (src/lib/bank-pricing UAE_NORMS), so there is always a resolved value.
  //
  // `ratePct` above is COMMISSION, not an interest rate — it is the only reason that
  // field has been confusing, so it is never shown next to a rate card again.
  defaultProcessingFeePct Float? // charged on the loan
  defaultValuationFeeAed  Float? // flat AED
  defaultPreApprovalAed   Float? // flat AED
  maxTenorYears           Int?   // 14/14 of our banks are internally consistent here
  maxLtvNational          Int?
  maxLtvExpatriate        Int?
  minSalaryAed            Int?
  totalTatDays            Int?
  paTatDays               Int?
  paValidityDays          Int?
  folValidityDays         Int?
  valuationValidityDays   Int?
  stressBufferPct         Float? // the bank's own stress rule
  cardRulePct             Float? // % of card limits counted in DBR
  bonusPct                Float? // % of bonus counted
  rentalIncomePct         Float? // % of rental counted
  maxAgeSalaried          Int?   // age at loan maturity
  maxAgeSelfEmp           Int?
  serviceMonthsMin        Int?   // "6 months in the same company"
  propertyAgeYearsMax     Int?
  firstPropertyOnly       Boolean @default(false)
  /** When a human last confirmed these defaults with the bank. An UNRECORDED date
   *  is the whole risk of a "constant": it rots silently. Drives the ⚠ badges. */
  defaultsVerifiedAt      String  @default("")
  /** Which mortgage types this bank offers at all — Islamic / Conventional / both.
   *  A set, not a value, so a master need not be duplicated per type. */
  offersIslamic           Boolean @default(true)
  offersConventional      Boolean @default(true)

  products BankProduct[]
}

// Bank rule product — one row per (bank x segment x product kind), decoded from
// the rates/policy workbooks. Typed headline fields feed the eligibility engine;
// axesJson keeps every raw axis verbatim. Versioned: imports create new versions,
// humans approve them (status draft → approved).
model BankProduct {
  id        Int     @id @default(autoincrement())
  bankId    Int
  name      String  // e.g. "Salaried · Conventional"
  sheet     String  // source sheet: Salaried | Self Employed | NR | Commercial Property | Low Doc
  employment String // Salaried | Self-Employed | Salaried or Self-Employed
  residency String  // Resident | Non-Resident
  financeType String @default("Residential") // Residential | Commercial
  program   String  @default("") // e.g. Low-Doc
  loanKind  String  @default("") // Conventional | Islamic | mixed

  // typed headline fields (parsed from axes — engine inputs)
  maxLtvNational    Int?
  maxLtvExpatriate  Int?
  minLoan           Int?
  maxLoan           Int?
  tenorYears        Int?
  minSalary         Int?
  // bank-specific affordability rules (default to CBUAE norms when null)
  cardRulePct       Float? // % of credit-card limit counted in DBR (DIB 2, most 5)
  bonusPct          Float? // % of bonus income considered (ENBD 50)
  rentalIncomePct   Float? // % of rental income considered (DIB 83, ENBD 60)
  rentalCapPctOfSalary Float? // rental credit capped at this % of primary salary (DIB 50)
  dbrPct            Float? // bank DBR ceiling override (default 50)
  stressBufferPct   Float? // extra cushion on top of the follow-on rate for DSR (CBD +2; default 0)
  maxAgeSalaried    Int?   // borrower age cap at loan maturity (salaried)
  maxAgeSelfEmp     Int?   // borrower age cap at loan maturity (self-employed)
  totalTatDays      Int?
  paTatDays         Int?
  paValidityDays    Int?
  folValidityDays   Int?
  valuationValidityDays Int?
  pricingJson       String @default("{}")
  feesJson          String @default("{}") // structured bank fees (processing / settlements)
  insuranceJson     String @default("{}") // structured insurance rates // structured rate quotes (see lib/bank-pricing.ts)
  rateTable         String @default("") // segmented pricing text (fixed/variable/buyout/equity)
  stressTest        String @default("")
  fees              String @default("")
  insurance         String @default("")
  eligibility       String @default("") // min salary/service/bonus/rental notes
  documents         String @default("")
  notes             String @default("")
  axesJson          String @default("{}") // full raw axes, verbatim

  // versioning workflow
  version      Int    @default(1)
  status       String @default("approved") // draft | approved
  effectiveDate String?
  expiryDate   String @default("2099-12-31") // default 31-Dec-2099
  approvedBy   String?
  sourceFiles  String @default("")
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bank BankItem @relation(fields: [bankId], references: [id], onDelete: Cascade)
  promotions Promotion[]
  projects ProjectProduct[]
  // Phase 7 — cases priced on this rate card. Two relations because "we quoted
  // this" and "they booked this" are different facts (see LoanCase).
  pricedCases   LoanCase[] @relation("CaseRateCard")
  bookedCases   LoanCase[] @relation("CaseBookedRateCard")

  // --- Eligibility rules the engine now actually READS (were previously free
  // text buried in eligibility/axesJson, so the engine never saw them) ---
  serviceMonthsMin  Int?   // "6 months in the same company" — very common UAE rule
  propertyAgeYearsMax Int? // some banks cap the age of the building itself
  firstPropertyOnly Boolean @default(false) // is this the client's first purchase?
  minServiceNote    String @default("") // source text for the above
  /** Availability restriction, NOT a customer segment: this product may only be
   *  sold for a specific developer/promotion (e.g. the 382 Huspy is_exclusive rows
   *  tied to Dubai Holding projects). The project itself lives in Project. */
  isExclusive       Boolean @default(false)
}

// Tier-4 override layer — festival bonanzas / fee waivers / rate cuts.
// NEVER overwrites base pricing: the engine applies an ACTIVE promo
// (validFrom <= today <= validTo, active=true) ON TOP of the resolved quote
// and it self-expires by date — no admin action needed to revert.
model Promotion {
  id                    Int      @id @default(autoincrement())
  bankProductId         Int
  name                  String
  description           String   @default("")
  rateOptionTermYears   Int?     // null = every rate option; else only that fixed term
  rateDiscountBps       Int?     // e.g. -25 reduces the intro rate by 0.25%
  processingFeeOverridePct Float? // null = keep base fee; 0 = waive entirely
  valuationFeeWaived    Boolean  @default(false)
  validFrom             String   // ISO date, inclusive
  validTo               String   // ISO date, inclusive
  active                Boolean  @default(true)
  createdBy             String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  bankProduct BankProduct @relation(fields: [bankProductId], references: [id], onDelete: Cascade)
}

// Current EIBOR benchmark rates — variable/stress formulas reference these live,
// so a quarterly update here reprices every bank correctly.
model EiborRate {
  tenor    String @id // ON | 1W | 1M | 3M | 6M | 1Y
  ratePct  Float
  updatedOn String @default("") // the rate's own reference date (publish/effective day)
  note     String @default("")
  updatedBy String @default("") // display name of the last editor
  effectiveFrom String? // the date the published rate takes effect (can differ from publish day)
  updatedAt DateTime @default(now()) @updatedAt
}

model PartnerItem {
  id                Int      @id @default(autoincrement())
  kind              String   // Agent | Broker | Referral
  name              String
  defaultSharePct   Int      @default(20)
  password          String   @default("agent123") // agent portal login
  active            Boolean  @default(true)
  contactsJson      String   @default("[]") // partner RMs: [{name,phone,email,role}]

  // agent-portal profile (self-edited in the portal; verification stamps are team-set)
  email             String?
  phone             String?
  about             String?
  expertise         String? // area of expertise, e.g. "Dubai Marina · off-plan"
  iban              String? // payout account — verified by the finance team
  ibanVerified      Boolean  @default(false)
  licenseNo         String? // RERA broker card / trade licence
  licenseVerified   Boolean  @default(false)
  avatarData        String? // small data URL (client-downscaled to ≤256px)

  @@unique([kind, name])
}

// Admin-configured portal settings (key-value): clientPortalAdvisorId,
// agentDeskName, agentDeskPhone — decided in Admin → Portal settings.
model AppSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @default(now()) @updatedAt
}

model SlaRule {
  id        Int      @id @default(autoincrement())
  stage     String
  bank      String? // null = all banks
  // Which service line's turnaround this SLA measures. NULL = global/legacy
  // (every existing rule); backfill-service-line.mjs assigns MORTGAGE. A golden
  // visa has no bank and its own clock, so it needs its own rows.
  serviceLineId Int?
  maxDays   Int
  active    Boolean  @default(true)

  serviceLine ServiceLine? @relation(fields: [serviceLineId], references: [id])

  @@index([serviceLineId])
}

model AffordabilityCheck {
  id               Int      @id @default(autoincrement())
  caseId           Int?
  customerName     String
  monthlyIncome    Int
  otherIncome      Int      @default(0)
  existingEmis     Int      @default(0)
  age              Int
  employmentType   String   // Salaried | Self-Employed
  propertyValue    Int
  bank             String
  interestRate     Float?
  tenureYears     Int?
  applicableLtv    Float
  maxLoanByLtv     Int
  maxDbrPct        Float
  availableDbrEmi  Int
  maxLoanByDbr     Int
  maxTenureByAge   Int
  finalEligibleLoan Int
  estimatedEmi     Int
  eligible         Boolean
  createdBy        Int
  createdAt        DateTime @default(now())
  payload          String?  // JSON snapshot of full mortgage input

  creator User @relation(fields: [createdBy], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

// Matched email — linked to a case, shown as a timeline entry on Case 360.
// Deliberately no body stored — just enough to know it happened + a deep link
// back to Outlook so the case officer can open the original.
model EmailLog {
  id          Int      @id @default(autoincrement())
  caseId      Int
  subject     String
  sender      String
  direction   String   @default("from_bank") // from_bank | from_client | internal
  receivedAt DateTime @default(now())
  outlookLink String?
  messageId   String?  @unique // dedup key from the inbound webhook

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// Unmatched email — fuzzy match wasn't confident enough to auto-link.
// Waits in a review queue until a human confirms, picks a different case, or ignores.
model UnmatchedEmail {
  id              Int       @id @default(autoincrement())
  subject         String
  sender          String
  receivedAt      DateTime  @default(now())
  bestGuessCaseId Int?
  status          String    @default("Pending") // Pending | Linked | Ignored
  messageId       String?   @unique
  resolvedBy      Int?
  resolvedAt      DateTime?
}


// Channel partners (Huspy, Prypco, etc.) — platforms that submit deals
// to banks on your behalf and take a cut of the loan amount.
model ChannelItem {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  commissionPct Float    @default(0.4) // % of loan amount the channel takes
  active        Boolean  @default(true)
  contactsJson  String   @default("[]") // channel RMs: [{name,phone,email,role}]
}

// Stage change log — powers the client portal timeline and the Case 360 history.
// Daily MIS log — dated progress entries per case. The latest entry is
// denormalized onto LoanCase.statusNote for the client portal; the log builds
// the team leader's daily register and the month-wise MIS reports.
model CaseUpdate {
  id        Int      @id @default(autoincrement())
  caseId    Int
  date      String   // MIS date (ISO)
  note      String
  onHold    Boolean  @default(false)
  holdReason String  @default("")
  authorId  Int
  createdAt DateTime @default(now())

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation("CaseUpdateAuthor", fields: [authorId], references: [id])
}

// Saved proposal — a Bank Match run frozen into a client-facing artifact.
// Lifecycle: draft -> sent -> won / lost. Historical versions keep the rule
// context they were generated under.
model Proposal {
  id        Int      @id @default(autoincrement())
  caseId    Int
  productIds String  @default("[]") // JSON array of BankProduct ids
  inputs    String   @default("{}") // the match inputs (income, property, stl, term…)
  mode      String   @default("client") // client | internal
  status    String   @default("draft") // draft | sent | won | lost
  version   Int      @default(1)
  createdBy Int
  sentAt    DateTime?
  decidedAt DateTime?
  createdAt DateTime @default(now())

  case         LoanCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author       User            @relation("ProposalAuthor", fields: [createdBy], references: [id])
  snapshot     ProposalSnapshot?
}

// Append-only audit trail for EVERY pricing-affecting mutation. A pricing engine
// must be able to answer "what did we tell the client on 3 March, and who changed
// it?" — approvedBy alone records only the last approver, not the before/after.
// Written by src/lib/audit.ts from the /api/admin routes.
model AuditLog {
  id        Int      @id @default(autoincrement())
  entity    String   // BankProduct | Promotion | FeeRule | AppSetting | DealException | BankItem
  entityId  String   // "" for key-value entities (AppSetting)
  action    String   // create | update | delete | revise | approve
  field     String   @default("") // the specific field/axis that moved (e.g. "quotes[2].ratePct")
  beforeVal String   @default("")
  afterVal  String   @default("")
  reason    String   @default("") // required at the point of entry for rate edits
  actorId   Int?
  actorName String   @default("")
  at        DateTime @default(now())

  @@index([entity, at])
  @@index([at])
}

// Named development (projects). The Huspy feed carries 382 is_exclusive products
// tied to specific projects ("Dubai Holding Exclusive - Jomana 8"); those are an
// AVAILABILITY restriction, not a customer segment, so they get their own layer
// instead of polluting the segment vocabulary.
model Project {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  developer String   @default("")
  emirate   String   @default("")
  promotion String   @default("") // e.g. "Dubai Holding"
  stage     String   @default("") // OFF_PLAN | HANDOVER | COMPLETED
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProjectProduct[]
}

// Which bank products are restricted to which project.
model ProjectProduct {
  id          Int    @id @default(autoincrement())
  projectId   Int
  bankProductId Int
  isExclusive Boolean @default(true)

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bankProduct BankProduct  @relation(fields: [bankProductId], references: [id], onDelete: Cascade)

  @@unique([projectId, bankProductId])
  @@index([bankProductId])
}

// Tier-3 pricing: a per-CASE exception below the standard floor. Deliberately the
// most restricted layer in the system — case-scoped, reason + expiry mandatory,
// super-admin only, second approver required, and rendered as an explicit
// "exception pricing" line on the proposal so it is never mistaken for a bank rate.
model DealException {
  id           Int      @id @default(autoincrement())
  caseId       Int
  bankProductId Int?
  rateDeltaBps Int      @default(0)      // e.g. -30 = 30bps better than the tier-1 rate
  feeWaive     Boolean  @default(false)  // waive processing fee on this deal
  reason       String   // MANDATORY — why this exception exists
  approvedBy   String   // second approver (must differ from createdBy)
  validFrom    String   // ISO date, inclusive
  validTo      String   // ISO date, inclusive — exceptions must expire
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// A proposal is a SNAPSHOT, not a live view. It never re-reads bank rates: if a
// bank repriced tomorrow, a proposal sent last month still shows what the client
// was actually told. This is what makes the document defensible.
model ProposalSnapshot {
  id          Int      @id @default(autoincrement())
  proposalId  Int
  inputsJson      String @default("{}") // client, property, loan — as entered
  eiborCurveJson  String @default("{}") // every tenor, as at capturedAt
  resultsJson     String @default("[]") // frozen MatchResult[] incl. followOn/stress EMIs
  floorJson       String @default("{}") // pricing floor in force at capture
  overlaysJson    String @default("[]") // which tier-2 promos were applied
  exceptionsJson  String @default("[]") // any tier-3 deal exceptions applied
  eiborCapturedAt String @default("")   // the EIBOR publication date shown to the client
  capturedAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@unique([proposalId])
}

model StageTransition {
  id        Int      @id @default(autoincrement())
  caseId    Int
  fromStage String
  toStage   String
  comment   String   @default("")
  userId    Int
  at        DateTime @default(now())

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id])
}

// Client portal session — separate from team sessions.
//
// PHASE 3 — WHY THIS IS CLIENT-SCOPED NOW: a session used to be pinned to ONE
// case (`caseId` required). The moment the firm sells more than one service, a
// person can hold a mortgage AND a golden-visa case AND a will, and a session
// bound to a single case means the portal can only ever show one of them — and a
// person who has registered as a LEAD has no case at all to log in with.
//
// So `clientId` is the real identity and `caseId` is only the ANCHOR (the case
// they happened to log in on). Both are kept during the transition: `clientId` is
// nullable so existing session rows keep working, and every access check goes
// through `clientOwnsCase` (lib/client-auth.ts) which resolves client-scope with
// a legacy fallback — never by trusting `caseId` alone.
model ClientSession {
  id        String   @id @default(cuid())
  // The PERSON. Nullable only while legacy rows are being backfilled.
  clientId  Int?
  // The case the client logged in on — the journey the portal opens by default.
  // NULLABLE as of Phase 4: a lead-only registrant has NO case yet. Their session
  // is still valid (clientId identifies them); the portal shows an empty state
  // until staff convert the lead, at which point the case appears automatically.
  // Before Phase 4 this was required, which is exactly why registration had to
  // invent a throwaway LoanCase just to hang a session off.
  caseId    Int?
  phone     String
  createdAt DateTime @default(now())
  expiresAt DateTime

  client Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case   LoanCase? @relation(fields: [caseId], references: [id])

  @@index([clientId])
  @@index([caseId])
}

// NOTE: the old case-scoped `ClientDocument` stub (caseId + filename/type/size only) used
// to sit here. It was RESHAPED IN PLACE into the person-level vault documented further
// down, rather than replaced by a second table. See that model's comment for why, and for
// why `caseId` survives as a nullable legacy pointer (the client portal still reads it).

// Document rule template — the master catalog behind the conditional Document
// Vault. Admin CRUD (Admin → Doc Rules). Conditions are JSON string arrays of
// allowed profile values; "all"/"any" match everything. Feeds per-case checklists.
model DocRule {
  id            Int     @id @default(autoincrement())
  code          String  @default("") // e.g. DOC-SAL-CERT
  name          String
  category      String  @default("KYC") // KYC | Income | Property | Bank & Liabilities | Internal Underwriting | Valuation | Transfer
  validityDays  Int     @default(0) // 0 = no fixed validity — rely on the note
  warnDays      Int     @default(7) // flag this many days before expiry
  verifyNotes   String  @default("") // what to check / rejection triggers
  // condition vectors (JSON arrays): "all"/"any" or specific values
  applicableEmployment   String @default("[\"all\"]")  // Salaried | Self-Employed | Non-Resident | all
  applicablePropertyType String @default("[\"any\"]")  // Ready | Off-Plan | any
  applicableTransaction  String @default("[\"any\"]")  // New Purchase | Buyout / Equity Release | any
  applicableResidency    String @default("[\"all\"]")  // UAE National | Resident Expatriate | Non-Resident | all
  // Per-bank document requirements. Every bank asks for something different
  // (a bank-specific valuation format, a particular salary-certificate window,
  // an extra internal-uw memo), and that difference is invisible without this
  // axis — a case used to get ONE uniform checklist regardless of which bank
  // it sat with. "any"/"all" = every bank, which is the default so every
  // existing rule keeps behaving exactly as it does today.
  applicableBank         String @default("[\"any\"]")
  // Which service line's checklist this rule belongs to. The property /
  // transaction / residency axes above are all mortgage vocabulary, so without
  // this a will or a golden-visa case would be handed a mortgage checklist.
  // NULL = legacy/global (every existing rule); backfill assigns MORTGAGE.
  serviceLineId   Int?
  // access rules
  mandatory           Boolean @default(true)  // blocks case progression when missing
  visibleToClient     Boolean @default(true)  // false = staff-internal only (AECB, memos…)
  clientCanUpload     Boolean @default(true)
  expiryTrackingRequired Boolean @default(true)
  active       Boolean @default(true)

  serviceLine ServiceLine? @relation(fields: [serviceLineId], references: [id])

  @@index([serviceLineId])
}

// CLIENT DOCUMENT — the person-level vault (Phase G).
//
// ⚠️ HISTORY, because it explains the odd shape: this model used to be a metadata-only
// stub hard-scoped to a CASE (`caseId`, onDelete: Cascade, filename/type/size only).
// It was reshaped in place rather than replaced by a new table. Verified before the
// change: **the table held 0 rows**, so nothing could be lost — but note the old
// `caseId` is kept below as a NULLABLE legacy pointer, because
// src/app/api/client/state/route.ts still reads `clientDocuments` per case for the
// client portal. Dropping the column would have silently emptied the portal's upload
// list.
//
// WHY IT IS NOW PERSON-SCOPED: a passport scan belongs to the HUMAN, not to one
// engagement. Case-scoped, it had to be re-uploaded for the mortgage, again for the
// golden visa, again for the will — and no file could see the others. A will is
// assembled from a person's entire picture (assets, liabilities, dependants), most of
// which other departments captured.
//
// ONE FILE, MANY USES: cases point at this row via CaseDocument.clientDocumentId, the
// same one-file-many-rows shape as `copiedFromId`, in the opposite direction. The bytes
// are stored once.
//
// THE TWO FIELDS THAT CARRY THE POLICY:
//   serviceLineId — WHICH DEPARTMENT owns it (null = firm-wide). Provenance is NEVER
//     rewritten: when the wills team attaches a bank valuation to read it, the document
//     stays "Mortgage · shared" and only the ATTACHMENT is recorded. A valuation
//     re-labelled "Wills" would misstate where it came from.
//   sharing — "All" | "Team" | "Department".
//     ALL        any staff may read/attach. THE DEFAULT, chosen deliberately: in a
//                six-service consultancy the person-level documents are overwhelmingly
//                KYC that every department needs, and the realistic failure is a
//                missing passport, not a leaked one.
//     Team       only the owning department (+ admins) may read/attach.
//     Department stricter still, for genuinely department-private material.
model ClientDocument {
  id        Int      @id @default(autoincrement())
  clientId  Int
  title     String
  category  String   @default("KYC") // KYC | Income | Asset | Property | Other
  // Which department owns this document. NULL = firm-wide (uploaded before any
  // department claimed the client).
  serviceLineId Int?
  sharing   String   @default("All") // All | Team | Department
  status    String   @default("Pending upload") // Pending upload | Uploaded | Verified | Rejected | Waived
  notes     String   @default("")
  rejectionReason String @default("")
  // Legacy case pointer. NULLABLE and no longer the identity of a row: it survives only
  // so the client portal's per-case upload list keeps working. New documents leave it
  // null and attach through CaseDocument.clientDocumentId instead.
  caseId    Int?
  // --- storage: mirrors CaseDocument exactly so R2 / Drive / version selection,
  // --- compression and the legacy Postgres-bytes fallback all behave identically ---
  fileName        String?
  fileType        String?
  fileSize        Int?
  fileData        Bytes?
  storageKey      String?
  compressedKey   String?
  compressedSize  Int?
  selectedVersion String   @default("original") // original | compressed
  driveFileId     String?
  displayName     String?
  source          String   @default("vault") // vault | chat
  expiryDate      String?  // ISO. Passport/EID/visa expire and must be chased.
  uploadedByKind  String   @default("")   // client | staff
  uploadedById    Int?
  uploadedAt      DateTime?
  verifiedById    Int?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  sortOrder       Int      @default(0)

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceLine ServiceLine? @relation(fields: [serviceLineId], references: [id])
  // Legacy case link. NOT Cascade any more: a person's vault must not be destroyed
  // because one engagement closed.
  legacyCase  LoanCase?    @relation(fields: [caseId], references: [id], onDelete: SetNull)

  // The cases this document is attached to. ONE row here can back many CaseDocuments.
  attachments CaseDocument[]

  @@index([clientId])
  @@index([caseId])
  @@index([serviceLineId])
  @@index([clientId, category])
}

// Per-case document instance — the living vault. Auto-populated from templates
// by the condition engine, plus ad-hoc additions; full CRUD on the case.
model CaseDocument {
  id              Int      @id @default(autoincrement())
  caseId          Int
  templateId      Int?     // null = ad-hoc document
  // Provenance for a document carried over from a SIBLING bank leg of the same
  // deal (see POST /api/cases/:id/add-bank). The file bytes are NOT duplicated —
  // the new row points at the same storage key — so this is purely the audit
  // trail answering "why does the ADCB leg already have the EID, nobody asked
  // the client twice?". Null on every document that was uploaded for real.
  copiedFromId    Int?
  copiedFrom      CaseDocument?  @relation("DocCopy", fields: [copiedFromId], references: [id])
  copies          CaseDocument[] @relation("DocCopy")
  // Phase G — points at the person-level vault entry this row is an instance of. The
  // FILE BYTES ARE NOT DUPLICATED: this row is a cheap pointer, so one passport scan in
  // ClientDocument can satisfy the EID slot on a mortgage, a golden visa AND a will at
  // once. Null on every document uploaded directly against a case, which is all of
  // them today.
  //
  // Same one-file-many-rows shape as copiedFromId above, in the opposite direction.
  clientDocumentId Int?
  clientDocument   ClientDocument? @relation(fields: [clientDocumentId], references: [id], onDelete: SetNull)
  title           String
  category        String   @default("KYC")
  status          String   @default("Pending upload") // Pending upload | Uploaded | Verified | Rejected | Waived
  mandatory       Boolean  @default(true)
  visibleToClient Boolean  @default(true)
  clientCanUpload Boolean  @default(true)
  rejectionReason String   @default("")
  notes           String   @default("")
  fileName        String?
  fileType        String?
  fileSize        Int?
  fileData        Bytes?
  expiryDate      String?
  uploadedByKind  String   @default("") // client | staff
  uploadedById    Int?
  uploadedAt      DateTime?
  verifiedById    Int?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  sortOrder       Int      @default(0)
  // --- Object storage (Cloudflare R2). Null storageKey = legacy Postgres-bytes row. ---
  storageKey      String?  // R2 key of the ORIGINAL file (full quality, bank-submission grade)
  compressedKey   String?  // R2 key of the compressed version (null until a team member compresses)
  compressedSize  Int?
  selectedVersion String   @default("original") // which version downloads/ZIP use: "original" | "compressed"
  driveFileId     String?  // Google Drive mirror file id (optional integration)
  displayName     String?  // user-facing inline renamed title (falls back to title/fileName)
  source          String   @default("vault") // vault | chat

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// WhatsApp / email / call templates used by the Case 360 stage drawer.
// Wording lives here (admin-editable) while the stage files only reference a
// template key — so messaging changes never touch stage logic. Placeholders
// use {{customer}} {{caseNumber}} {{amount}} {{bank}} {{owner}} … and unknown
// keys render as "—" (see src/lib/workflow/comms/render.ts).
model CommTemplate {
  id        Int     @id @default(autoincrement())
  key       String  @unique // wa-group-invite, em-val-request, call-fol-client-script …
  channel   String  @default("whatsapp") // whatsapp | email | call
  stageKey  String  @default("doc")      // doc | pre | val | fol | transfer
  bank      String? // null = every bank
  // stageKey above is mortgage vocabulary; this is the owning service line so a
  // golden-visa "application submitted" message does not have to masquerade as
  // one of the 5 mortgage keys. NULL = legacy/global; backfill assigns MORTGAGE.
  serviceLineId Int?
  name      String
  subject   String? // email only
  body      String
  vars      String  @default("[]") // JSON array of placeholder names used in body
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  serviceLine ServiceLine? @relation(fields: [serviceLineId], references: [id])

  @@index([serviceLineId])
}

// SOP §6.9 — Government & bank transfer fee matrices (Dubai / Abu Dhabi).
// Admin-managed (Admin → Fee rules); feeds the Calculator's Transfer Fees tab.
model FeeRule {
  id         Int     @id @default(autoincrement())
  emirate    String  // Dubai | Abu Dhabi
  txnType    String  // Primary | Resale | Buyout
  label      String
  amountType String  // pct_property | pct_loan | fixed
  amount     Float
  paidBy     String  @default("Client") // Client | Seller
  note       String  @default("")
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  @@index([emirate, txnType])
}

// Live real-time chat messages between Staff ↔ Client and Staff ↔ Agent
model ChatMessage {
  id              Int       @id @default(autoincrement())
  caseId          Int
  senderId        Int?      // Nullable: null if sent by external client/agent
  senderType      String    // STAFF | CLIENT | AGENT
  senderName      String    // e.g. "Ahmed Al-Mansouri (HFMC)", "Lakshmi Nair"
  threadType      String    @default("CLIENT") // CLIENT (Client ↔ Staff) | AGENT (Agent ↔ Staff)
  text            String?
  attachmentKey   String?   // R2 object key
  attachmentName  String?   // Display name of attachment
  attachmentSize  Int?      // Size in bytes
  mimeType        String?   // MIME type
  sentAt          DateTime  @default(now())
  readByStaff     Boolean   @default(false)
  readByExternal  Boolean   @default(false)

  case   LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender User?    @relation(fields: [senderId], references: [id])

  @@index([caseId, threadType, sentAt])
}

// Track registered user devices, PWA install state, and Web Push (VAPID) subscriptions
model UserDevice {
  id           Int       @id @default(autoincrement())
  userId       Int?      // Populated for Staff / Agent user
  caseId       Int?      // Populated for Client (scoped to their case)
  deviceType   String    // 'mobile' | 'desktop' | 'tablet'
  pwaInstalled Boolean   @default(false)
  installedAt  DateTime?
  pushEndpoint String?   @unique
  pushP256dh   String?
  pushAuth     String?
  lastSeenAt   DateTime  @default(now())
  userAgent    String?

  user User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case LoanCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([caseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTERNAL STAFF CHAT (staff-only; zero overlap with the client ChatMessage)
//
// WHY SEPARATE MODELS: ChatMessage is client-scoped (caseId is not optional)
// and carries client auth logic.  Staff rooms are person-to-person — no case
// required — so a different model tree prevents the auth rules from bleeding.
// ─────────────────────────────────────────────────────────────────────────────

model StaffRoom {
  id          Int      @id @default(autoincrement())
  // Human-readable name set by creator.  For DM rooms the API auto-generates
  // "<nameA> & <nameB>" but the UI can override at render time.
  name        String
  isDirect    Boolean  @default(false)  // true = 2-person DM, no add/remove members
  createdAt   DateTime @default(now())
  createdById Int

  createdBy User              @relation("RoomCreator", fields: [createdById], references: [id])
  members   StaffRoomMember[]
  messages  StaffMessage[]

  @@index([createdById])
}

model StaffRoomMember {
  roomId     Int
  userId     Int
  joinedAt   DateTime  @default(now())
  // Cursor: last time this member opened the room. Messages after this = unread.
  lastReadAt DateTime?

  room StaffRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model StaffMessage {
  id             Int       @id @default(autoincrement())
  roomId         Int
  senderId       Int
  text           String?
  attachmentKey  String?
  attachmentName String?
  attachmentSize Int?
  mimeType       String?
  fileData       Bytes?
  sentAt         DateTime  @default(now())
  editedAt       DateTime?  // set when sender edits (reserved for future)

  room   StaffRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User      @relation(fields: [senderId], references: [id])

  @@index([roomId, sentAt])
  @@index([senderId])
}
