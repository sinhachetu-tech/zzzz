// HFMC — Mortgage Case Tracker. Relational schema (an upgrade from the
// original single-JSON-blob model acknowledged in the source as a future step).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      String // designation label, e.g. "Mortgage Head"
  team      String
  active    Boolean  @default(true)
  phone     String?  // WhatsApp / direct line — shown to clients (advisor card) and agents (desk card)
  // Microsoft Graph (delegated) tokens for send-mail-as-user
  graphAccessToken      String?
  graphRefreshToken     String?
  graphTokenExpiresAt   DateTime?
  graphConnectedAt      DateTime?
  createdAt DateTime @default(now())

  ownedCases      LoanCase[]      @relation("CaseOwner")
  advisedCases    LoanCase[]      @relation("CaseAdvisor")
  backupOneCases  LoanCase[]      @relation("CaseBackupOne")
  backupTwoCases  LoanCase[]      @relation("CaseBackupTwo")
  createdTasks    Task[]          @relation("TaskCreator")
  assignedTasks   Task[]          @relation("TaskAssignee")
  activities      Activity[]
  issuedInstructions Instruction[] @relation("InstrIssuer")
  assignedInstructions Instruction[] @relation("InstrAssignee")
  issuedBulletins  BulletinItem[]  @relation("BulletinIssuer")
  bulletins        BulletinTarget[]
  bulletinReplies  Reply[]         @relation("ReplyUser")
  instructionReplies InstrReply[]  @relation("InstrReplyUser")
  affordabilityChecks AffordabilityCheck[]
  sessions         Session[]
  stageTransitions StageTransition[]
  vrmCases         LoanCase[] @relation("CaseVrm")
  caseUpdateAuthors CaseUpdate[] @relation("CaseUpdateAuthor")
  proposals Proposal[] @relation("ProposalAuthor")
  sentChatMessages ChatMessage[]
  devices          UserDevice[]
}

model Designation {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  scope     String   // "all" | "team" | "own"
  issueTasks Boolean @default(false)
  admin     Boolean  @default(false)
  super     Boolean  @default(false)
  viewRevenue Boolean @default(false) // commission rates & earnings are restricted
  editEibor Boolean  @default(false) // may update the daily EIBOR benchmark table
  manageDocs Boolean @default(true)  // may upload/verify/reject/waive/delete/compress vault documents
  clientChat Boolean @default(true)  // may reply to client & agent chats
  builtIn  Boolean  @default(false)
}

// Client master — one row per human (borrower, co-borrower, co-applicant).
// The anchor for repeat business: every engagement (mortgage case today, a
// buyout in three years, an insurance policy after that) links back to the
// same person. Each case keeps its own profileJson snapshot as filed; this
// record holds the latest known truth, refreshed whenever a case profile is
// saved. Auto-merge key is the phone number only — name collisions never
// auto-merge (duplicates are cheap, wrong merges are not).
model Client {
  id        Int      @id @default(autoincrement())
  fullName  String
  // KYC identity — what actually decides "same person". EID is legally unique
  // in the UAE (definite auto-merge); passport is strong but renewable; phone
  // is only a hint (families share numbers) and never merges alone.
  eidNo     String?  @unique // Emirates ID, stored digits-only (784XXXXXXXXXXXX)
  passportNo String?
  phone     String   @default("") // digits only — match hint, never a sole merge key
  email     String?
  dob       String?
  nationality String?
  residency String   @default("Resident Expatriate")
  emirate   String?
  employmentProfile String @default("Salaried")
  companyName String?
  // latest-known financial snapshot (emptier profiles never erase these)
  monthlySalary   Int @default(0)
  variableIncome  Int @default(0)
  rentalIncome    Int @default(0)
  existingEmis    Int @default(0)
  creditCardLimits Int @default(0)
  notes     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  primaryCases     LoanCase[] @relation("PrimaryClient")
  secondPartyCases LoanCase[] @relation("SecondPartyClient")

  @@index([phone])
  @@index([passportNo])
}

model LoanCase {
  id          Int      @id @default(autoincrement())
  caseNumber  String   @unique
  customer    String
  banks       String   @default("[]") // JSON array of bank names
  wonBank     String?
  loanAmount  Int
  stage       String
  caseStatus  String   @default("Active") // Active | Closed | Lost
  closedDate  String?
  ownerId     Int
  source      String   @default("Direct") // Direct | Agent | Broker | Website | Referral
  partnerKind String?  // Agent | Broker | Referral
  partnerName String?
  partnerRm   String? // the partner's RM/coordinator handling this file
  partnerSharePct Int?
  // Two-way commission: submission type (direct to bank vs through channel)
  submissionType String  @default("direct") // direct | channel
  channelId      Int?
  channelName    String?   // denormalized for history
  channelRatePct Float   @default(0)  // channel's cut as % of loan amount (e.g. 0.4)
  whatsapp    String   @default("")
  waGroup     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Document Vault profile vectors — drive the conditional checklist ---
  employmentProfile String @default("Salaried") // Salaried | Self-Employed | Non-Resident (legacy display)
  propertyType      String @default("Ready")    // Ready | Off-Plan (legacy display only)
  residency         String @default("Resident Expatriate") // UAE National | Resident Expatriate | Non-Resident

  // --- FINAL PROPERTY CLASSIFICATION (canonical dims, additive, UNKNOWN-safe) ---
  // Stored separately from case stage/status: property stage describes the
  // PROPERTY; case stage describes the mortgage application. Ambiguous legacy
  // rows are backfilled to UNKNOWN/TO_VERIFY — never guessed. See
  // src/lib/case-profile.ts backfillCanonicalProperty for the mapping rules
  // (Off-plan NEVER implies Under-construction; Handover NEVER implies
  // construction Completed).
  propertyTypeCanonical  String  @default("UNKNOWN") // RESIDENTIAL | COMMERCIAL | UNKNOWN
  commercialSubtype      String?                     // OFFICE | RETAIL_SHOP | ... | UNKNOWN; NULL iff not COMMERCIAL
  propertyStage          String  @default("UNKNOWN") // OFF_PLAN | HANDOVER | COMPLETED | UNKNOWN
  constructionStatus     String  @default("UNKNOWN") // NOT_STARTED | UNDER_CONSTRUCTION | COMPLETED | UNKNOWN
  partyRelationship      String  @default("UNKNOWN") // DEVELOPER | EXISTING_OWNER | SELF | UNKNOWN
  existingFinance        String  @default("UNKNOWN") // NONE | MORTGAGE | UNKNOWN
  transactionPurpose     String  @default("UNKNOWN") // PURCHASE | REFINANCE | EQUITY_RELEASE | REFINANCE_AND_EQUITY | UNKNOWN

  // --- MIS operational fields (feed the client portal + daily updates) ---
  statusNote       String  @default("") // daily free-text status narrative shown to the client
  bankRm           String? // bank relationship manager name
  vrmId            Int?    // internal VRM handling the file (maker), distinct from the owner
  transactionType  String  @default("") // Buyout, Primary Handover, Resale, Equity Release…
  propertyLocation String? // Dubai, Abu Dhabi, ADGM…
  coApplicantName  String?
  profileJson      String  @default("{}") // structured primary applicant, property & co-borrower profile
  onHold           Boolean @default(false)
  holdReason       String?
  holdUntil        String? // ISO date
  lostReason       String? // why a lead/case was marked lost (audit trail — no hard delete for losses)
  // --- Bank submission tracking ---
  loanType          String? // NSTL | STL (non-salary vs salary transfer)
  fileSubmittedDate String? // when the file was submitted to the bank
  bankRate          Float?  // rate the bank quoted
  bankTenor         Int?    // tenor the bank approved (months)
  // --- Pre-approval stage capture ---
  preApprovalDate   String?
  preApprovalAmount Int?
  preApprovalTenure Int?
  preApprovalRoi    Float?
  // --- Final Offer Letter capture ---
  folDate   String?
  folAmount Int?
  folTenure Int?
  folRoi    Float?

  // --- Stage timeline (Case 360 drawer captures these directly; the stage
  // ticks read FIELDS first and only fall back to daily-note sniffing).
  // RULE: folConversionDate must be set before folSignedDate — the drawer
  // locks 4.4 signing until 4.1 conversion + 4.2 verification are on file.
  valuationInitiatedDate String? // stage 3 — valuation request sent to the bank
  inspectionDate         String? // stage 3 — inspection coordinated
  valuationReportDate    String? // stage 3 — report received (positive)
  folConversionDate      String? // stage 4 step 4.1 — conversion sent to banker
  folSignedDate          String? // stage 4 step 4.4 — client signed (never before conversion)
  ddaActive              Boolean @default(false) // stage 4 step 4.5 — DDA activated
  liabilityLetterDate    String? // stage 5 — liability letter received (resale w/ mortgage)
  settlementDate         String? // stage 5 — settlement/MC executed with the bank
  transferDate           String? // stage 5 — transfer appointment day
  titleDeedDate          String? // stage 5 — new Title Deed issued / QC done

  // --- Client master links (repeat business across engagements) ---
  clientId            Int? // primary applicant → Client
  secondPartyClientId Int? // co-borrower / co-applicant → their own Client row
  advisorId           Int? // the client-facing advisor (may differ from the owner who runs the file)
  backup1Id           Int? // first backup staffer — covers the file while the owner is on leave
  backup2Id           Int? // second backup staffer — covers the file while the owner is on leave
  profileClientVerifiedAt DateTime? // when the CLIENT last confirmed their own data sheet

  owner      User      @relation("CaseOwner", fields: [ownerId], references: [id])
  advisor    User?     @relation("CaseAdvisor", fields: [advisorId], references: [id])
  backup1    User?     @relation("CaseBackupOne", fields: [backup1Id], references: [id])
  backup2    User?     @relation("CaseBackupTwo", fields: [backup2Id], references: [id])
  vrm        User?     @relation("CaseVrm", fields: [vrmId], references: [id])
  tasks      Task[]
  activities Activity[]
  instructions Instruction[]
  bulletins  BulletinItem[]
  emails     EmailLog[]
  stageTransitions StageTransition[]
  clientDocuments  ClientDocument[]
  clientSessions   ClientSession[]
  vaultDocuments   CaseDocument[]
  caseUpdates      CaseUpdate[]
  proposals        Proposal[]
  notificationOverrides String? // JSON override: { push?: boolean, whatsapp?: boolean, email?: boolean }
  chatMessages     ChatMessage[]
  devices          UserDevice[]
  client           Client?  @relation("PrimaryClient", fields: [clientId], references: [id])
  secondPartyClient Client? @relation("SecondPartyClient", fields: [secondPartyClientId], references: [id])
}

model Task {
  id          Int      @id @default(autoincrement())
  caseId      Int
  description String
  ownerId     Int
  createdBy   Int
  waitingFor  String
  whyPending  String
  createdAt   DateTime @default(now())
  dueDate     String
  status      String   @default("Open") // Open | Done
  completedAt DateTime?
  remarks     String   @default("")

  case     LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  owner    User     @relation("TaskAssignee", fields: [ownerId], references: [id])
  creator  User     @relation("TaskCreator", fields: [createdBy], references: [id])
}

model Activity {
  id        Int      @id @default(autoincrement())
  caseId    Int
  userId    Int
  at        DateTime @default(now())
  action    String
  oldValue  String?
  newValue  String?

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id])
}

model Instruction {
  id          Int      @id @default(autoincrement())
  caseId      Int
  issuedBy    Int
  instruction String
  assignedTo  Int
  dueDate     String
  status      String   @default("Open")
  createdAt   DateTime @default(now())
  completedAt DateTime?

  case     LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  issuer   User     @relation("InstrIssuer", fields: [issuedBy], references: [id])
  assignee User     @relation("InstrAssignee", fields: [assignedTo], references: [id])
  replies  InstrReply[]
}

model InstrReply {
  id            Int      @id @default(autoincrement())
  instructionId Int
  userId        Int
  text          String
  at            DateTime @default(now())

  instruction Instruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  user        User         @relation("InstrReplyUser", fields: [userId], references: [id])
}

model BulletinItem {
  id           Int      @id @default(autoincrement())
  date         String   // ISO date this directive belongs to
  issuedBy     Int
  task         String
  caseId       Int?
  status       String   @default("Open")
  completedAt  DateTime?
  completedBy  Int?
  createdAt    DateTime @default(now())
  carriedFrom  String?
  dropped      Boolean  @default(false)
  templateId   Int?
  isTemplate   Boolean  @default(false)
  repeat       String?  // none | daily | weekdays

  issuer    User             @relation("BulletinIssuer", fields: [issuedBy], references: [id])
  targets   BulletinTarget[]
  replies   Reply[]
  case      LoanCase?        @relation(fields: [caseId], references: [id])
}

model BulletinTarget {
  id          Int @id @default(autoincrement())
  bulletinId  Int
  userId      Int

  bulletin BulletinItem @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id])
}

model Reply {
  id          Int      @id @default(autoincrement())
  bulletinId  Int
  userId      Int
  text        String
  at          DateTime @default(now())

  bulletin BulletinItem @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  user     User          @relation("ReplyUser", fields: [userId], references: [id])
}

model StageItem {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
}

model MasterItem {
  id        Int      @id @default(autoincrement())
  kind      String   // "whyPending" | "waitingFor"
  label     String
  active    Boolean  @default(true)

  @@unique([kind, label])
}

model BankItem {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  ratePct   Float   @default(0)
  active    Boolean @default(true)
  // professional profile
  logoData  Bytes?
  logoType  String?
  posPoints String  @default("") // negotiating intel — positives
  negPoints String  @default("") // negotiating intel — negatives
  website   String?
  contactsJson String @default("[]") // bank RM contacts: [{name,phone,email,role}]

  products BankProduct[]
}

// Bank rule product — one row per (bank x segment x product kind), decoded from
// the rates/policy workbooks. Typed headline fields feed the eligibility engine;
// axesJson keeps every raw axis verbatim. Versioned: imports create new versions,
// humans approve them (status draft → approved).
model BankProduct {
  id        Int     @id @default(autoincrement())
  bankId    Int
  name      String  // e.g. "Salaried · Conventional"
  sheet     String  // source sheet: Salaried | Self Employed | NR | Commercial Property | Low Doc
  employment String // Salaried | Self-Employed | Salaried or Self-Employed
  residency String  // Resident | Non-Resident
  financeType String @default("Residential") // Residential | Commercial
  program   String  @default("") // e.g. Low-Doc
  loanKind  String  @default("") // Conventional | Islamic | mixed

  // typed headline fields (parsed from axes — engine inputs)
  maxLtvNational    Int?
  maxLtvExpatriate  Int?
  minLoan           Int?
  maxLoan           Int?
  tenorYears        Int?
  minSalary         Int?
  // bank-specific affordability rules (default to CBUAE norms when null)
  cardRulePct       Float? // % of credit-card limit counted in DBR (DIB 2, most 5)
  bonusPct          Float? // % of bonus income considered (ENBD 50)
  rentalIncomePct   Float? // % of rental income considered (DIB 83, ENBD 60)
  rentalCapPctOfSalary Float? // rental credit capped at this % of primary salary (DIB 50)
  dbrPct            Float? // bank DBR ceiling override (default 50)
  stressBufferPct   Float? // extra cushion on top of the follow-on rate for DSR (CBD +2; default 0)
  maxAgeSalaried    Int?   // borrower age cap at loan maturity (salaried)
  maxAgeSelfEmp     Int?   // borrower age cap at loan maturity (self-employed)
  totalTatDays      Int?
  paTatDays         Int?
  paValidityDays    Int?
  folValidityDays   Int?
  valuationValidityDays Int?
  pricingJson       String @default("{}")
  feesJson          String @default("{}") // structured bank fees (processing / settlements)
  insuranceJson     String @default("{}") // structured insurance rates // structured rate quotes (see lib/bank-pricing.ts)
  rateTable         String @default("") // segmented pricing text (fixed/variable/buyout/equity)
  stressTest        String @default("")
  fees              String @default("")
  insurance         String @default("")
  eligibility       String @default("") // min salary/service/bonus/rental notes
  documents         String @default("")
  notes             String @default("")
  axesJson          String @default("{}") // full raw axes, verbatim

  // versioning workflow
  version      Int    @default(1)
  status       String @default("approved") // draft | approved
  effectiveDate String?
  expiryDate   String @default("2099-12-31") // default 31-Dec-2099
  approvedBy   String?
  sourceFiles  String @default("")
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bank BankItem @relation(fields: [bankId], references: [id], onDelete: Cascade)
  promotions Promotion[]
}

// Tier-4 override layer — festival bonanzas / fee waivers / rate cuts.
// NEVER overwrites base pricing: the engine applies an ACTIVE promo
// (validFrom <= today <= validTo, active=true) ON TOP of the resolved quote
// and it self-expires by date — no admin action needed to revert.
model Promotion {
  id                    Int      @id @default(autoincrement())
  bankProductId         Int
  name                  String
  description           String   @default("")
  rateOptionTermYears   Int?     // null = every rate option; else only that fixed term
  rateDiscountBps       Int?     // e.g. -25 reduces the intro rate by 0.25%
  processingFeeOverridePct Float? // null = keep base fee; 0 = waive entirely
  valuationFeeWaived    Boolean  @default(false)
  validFrom             String   // ISO date, inclusive
  validTo               String   // ISO date, inclusive
  active                Boolean  @default(true)
  createdBy             String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  bankProduct BankProduct @relation(fields: [bankProductId], references: [id], onDelete: Cascade)
}

// Current EIBOR benchmark rates — variable/stress formulas reference these live,
// so a quarterly update here reprices every bank correctly.
model EiborRate {
  tenor    String @id // ON | 1W | 1M | 3M | 6M | 1Y
  ratePct  Float
  updatedOn String @default("") // the rate's own reference date (publish/effective day)
  note     String @default("")
  updatedBy String @default("") // display name of the last editor
  effectiveFrom String? // the date the published rate takes effect (can differ from publish day)
  updatedAt DateTime @default(now()) @updatedAt
}

model PartnerItem {
  id                Int      @id @default(autoincrement())
  kind              String   // Agent | Broker | Referral
  name              String
  defaultSharePct   Int      @default(20)
  password          String   @default("agent123") // agent portal login
  active            Boolean  @default(true)
  contactsJson      String   @default("[]") // partner RMs: [{name,phone,email,role}]

  // agent-portal profile (self-edited in the portal; verification stamps are team-set)
  email             String?
  phone             String?
  about             String?
  expertise         String? // area of expertise, e.g. "Dubai Marina · off-plan"
  iban              String? // payout account — verified by the finance team
  ibanVerified      Boolean  @default(false)
  licenseNo         String? // RERA broker card / trade licence
  licenseVerified   Boolean  @default(false)
  avatarData        String? // small data URL (client-downscaled to ≤256px)

  @@unique([kind, name])
}

// Admin-configured portal settings (key-value): clientPortalAdvisorId,
// agentDeskName, agentDeskPhone — decided in Admin → Portal settings.
model AppSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @default(now()) @updatedAt
}

model SlaRule {
  id        Int      @id @default(autoincrement())
  stage     String
  bank      String? // null = all banks
  maxDays   Int
  active    Boolean  @default(true)
}

model AffordabilityCheck {
  id               Int      @id @default(autoincrement())
  caseId           Int?
  customerName     String
  monthlyIncome    Int
  otherIncome      Int      @default(0)
  existingEmis     Int      @default(0)
  age              Int
  employmentType   String   // Salaried | Self-Employed
  propertyValue    Int
  bank             String
  interestRate     Float?
  tenureYears     Int?
  applicableLtv    Float
  maxLoanByLtv     Int
  maxDbrPct        Float
  availableDbrEmi  Int
  maxLoanByDbr     Int
  maxTenureByAge   Int
  finalEligibleLoan Int
  estimatedEmi     Int
  eligible         Boolean
  createdBy        Int
  createdAt        DateTime @default(now())
  payload          String?  // JSON snapshot of full mortgage input

  creator User @relation(fields: [createdBy], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

// Matched email — linked to a case, shown as a timeline entry on Case 360.
// Deliberately no body stored — just enough to know it happened + a deep link
// back to Outlook so the case officer can open the original.
model EmailLog {
  id          Int      @id @default(autoincrement())
  caseId      Int
  subject     String
  sender      String
  direction   String   @default("from_bank") // from_bank | from_client | internal
  receivedAt DateTime @default(now())
  outlookLink String?
  messageId   String?  @unique // dedup key from the inbound webhook

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// Unmatched email — fuzzy match wasn't confident enough to auto-link.
// Waits in a review queue until a human confirms, picks a different case, or ignores.
model UnmatchedEmail {
  id              Int       @id @default(autoincrement())
  subject         String
  sender          String
  receivedAt      DateTime  @default(now())
  bestGuessCaseId Int?
  status          String    @default("Pending") // Pending | Linked | Ignored
  messageId       String?   @unique
  resolvedBy      Int?
  resolvedAt      DateTime?
}


// Channel partners (Huspy, Prypco, etc.) — platforms that submit deals
// to banks on your behalf and take a cut of the loan amount.
model ChannelItem {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  commissionPct Float    @default(0.4) // % of loan amount the channel takes
  active        Boolean  @default(true)
  contactsJson  String   @default("[]") // channel RMs: [{name,phone,email,role}]
}

// Stage change log — powers the client portal timeline and the Case 360 history.
// Daily MIS log — dated progress entries per case. The latest entry is
// denormalized onto LoanCase.statusNote for the client portal; the log builds
// the team leader's daily register and the month-wise MIS reports.
model CaseUpdate {
  id        Int      @id @default(autoincrement())
  caseId    Int
  date      String   // MIS date (ISO)
  note      String
  onHold    Boolean  @default(false)
  holdReason String  @default("")
  authorId  Int
  createdAt DateTime @default(now())

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation("CaseUpdateAuthor", fields: [authorId], references: [id])
}

// Saved proposal — a Bank Match run frozen into a client-facing artifact.
// Lifecycle: draft -> sent -> won / lost. Historical versions keep the rule
// context they were generated under.
model Proposal {
  id        Int      @id @default(autoincrement())
  caseId    Int
  productIds String  @default("[]") // JSON array of BankProduct ids
  inputs    String   @default("{}") // the match inputs (income, property, stl, term…)
  mode      String   @default("client") // client | internal
  status    String   @default("draft") // draft | sent | won | lost
  version   Int      @default(1)
  createdBy Int
  sentAt    DateTime?
  decidedAt DateTime?
  createdAt DateTime @default(now())

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation("ProposalAuthor", fields: [createdBy], references: [id])
}

model StageTransition {
  id        Int      @id @default(autoincrement())
  caseId    Int
  fromStage String
  toStage   String
  comment   String   @default("")
  userId    Int
  at        DateTime @default(now())

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id])
}

// Client portal session — separate from team sessions.
// Clients log in with case number + last 4 digits of their phone, not a password.
model ClientSession {
  id        String   @id @default(cuid())
  caseId    Int
  phone     String
  createdAt DateTime @default(now())
  expiresAt DateTime
  case      LoanCase @relation(fields: [caseId], references: [id])
}

// Client-uploaded documents — metadata only; files live in storage/G-Drive.
model ClientDocument {
  id         Int      @id @default(autoincrement())
  caseId     Int
  fileName   String
  fileType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
  case       LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// Document rule template — the master catalog behind the conditional Document
// Vault. Admin CRUD (Admin → Doc Rules). Conditions are JSON string arrays of
// allowed profile values; "all"/"any" match everything. Feeds per-case checklists.
model DocRule {
  id            Int     @id @default(autoincrement())
  code          String  @default("") // e.g. DOC-SAL-CERT
  name          String
  category      String  @default("KYC") // KYC | Income | Property | Bank & Liabilities | Internal Underwriting | Valuation | Transfer
  validityDays  Int     @default(0) // 0 = no fixed validity — rely on the note
  warnDays      Int     @default(7) // flag this many days before expiry
  verifyNotes   String  @default("") // what to check / rejection triggers
  // condition vectors (JSON arrays): "all"/"any" or specific values
  applicableEmployment   String @default("[\"all\"]")  // Salaried | Self-Employed | Non-Resident | all
  applicablePropertyType String @default("[\"any\"]")  // Ready | Off-Plan | any
  applicableTransaction  String @default("[\"any\"]")  // New Purchase | Buyout / Equity Release | any
  applicableResidency    String @default("[\"all\"]")  // UAE National | Resident Expatriate | Non-Resident | all
  // access rules
  mandatory           Boolean @default(true)  // blocks case progression when missing
  visibleToClient     Boolean @default(true)  // false = staff-internal only (AECB, memos…)
  clientCanUpload     Boolean @default(true)
  expiryTrackingRequired Boolean @default(true)
  active       Boolean @default(true)
}

// Per-case document instance — the living vault. Auto-populated from templates
// by the condition engine, plus ad-hoc additions; full CRUD on the case.
model CaseDocument {
  id              Int      @id @default(autoincrement())
  caseId          Int
  templateId      Int?     // null = ad-hoc document
  title           String
  category        String   @default("KYC")
  status          String   @default("Pending upload") // Pending upload | Uploaded | Verified | Rejected | Waived
  mandatory       Boolean  @default(true)
  visibleToClient Boolean  @default(true)
  clientCanUpload Boolean  @default(true)
  rejectionReason String   @default("")
  notes           String   @default("")
  fileName        String?
  fileType        String?
  fileSize        Int?
  fileData        Bytes?
  expiryDate      String?
  uploadedByKind  String   @default("") // client | staff
  uploadedById    Int?
  uploadedAt      DateTime?
  verifiedById    Int?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  sortOrder       Int      @default(0)
  // --- Object storage (Cloudflare R2). Null storageKey = legacy Postgres-bytes row. ---
  storageKey      String?  // R2 key of the ORIGINAL file (full quality, bank-submission grade)
  compressedKey   String?  // R2 key of the compressed version (null until a team member compresses)
  compressedSize  Int?
  selectedVersion String   @default("original") // which version downloads/ZIP use: "original" | "compressed"
  driveFileId     String?  // Google Drive mirror file id (optional integration)
  displayName     String?  // user-facing inline renamed title (falls back to title/fileName)
  source          String   @default("vault") // vault | chat

  case LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// WhatsApp / email / call templates used by the Case 360 stage drawer.
// Wording lives here (admin-editable) while the stage files only reference a
// template key — so messaging changes never touch stage logic. Placeholders
// use {{customer}} {{caseNumber}} {{amount}} {{bank}} {{owner}} … and unknown
// keys render as "—" (see src/lib/workflow/comms/render.ts).
model CommTemplate {
  id        Int     @id @default(autoincrement())
  key       String  @unique // wa-group-invite, em-val-request, call-fol-client-script …
  channel   String  @default("whatsapp") // whatsapp | email | call
  stageKey  String  @default("doc")      // doc | pre | val | fol | transfer
  bank      String? // null = every bank
  name      String
  subject   String? // email only
  body      String
  vars      String  @default("[]") // JSON array of placeholder names used in body
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

// SOP §6.9 — Government & bank transfer fee matrices (Dubai / Abu Dhabi).
// Admin-managed (Admin → Fee rules); feeds the Calculator's Transfer Fees tab.
model FeeRule {
  id         Int     @id @default(autoincrement())
  emirate    String  // Dubai | Abu Dhabi
  txnType    String  // Primary | Resale | Buyout
  label      String
  amountType String  // pct_property | pct_loan | fixed
  amount     Float
  paidBy     String  @default("Client") // Client | Seller
  note       String  @default("")
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  @@index([emirate, txnType])
}

// Live real-time chat messages between Staff ↔ Client and Staff ↔ Agent
model ChatMessage {
  id              Int       @id @default(autoincrement())
  caseId          Int
  senderId        Int?      // Nullable: null if sent by external client/agent
  senderType      String    // STAFF | CLIENT | AGENT
  senderName      String    // e.g. "Ahmed Al-Mansouri (HFMC)", "Lakshmi Nair"
  threadType      String    @default("CLIENT") // CLIENT (Client ↔ Staff) | AGENT (Agent ↔ Staff)
  text            String?
  attachmentKey   String?   // R2 object key
  attachmentName  String?   // Display name of attachment
  attachmentSize  Int?      // Size in bytes
  mimeType        String?   // MIME type
  sentAt          DateTime  @default(now())
  readByStaff     Boolean   @default(false)
  readByExternal  Boolean   @default(false)

  case   LoanCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender User?    @relation(fields: [senderId], references: [id])

  @@index([caseId, threadType, sentAt])
}

// Track registered user devices, PWA install state, and Web Push (VAPID) subscriptions
model UserDevice {
  id           Int       @id @default(autoincrement())
  userId       Int?      // Populated for Staff / Agent user
  caseId       Int?      // Populated for Client (scoped to their case)
  deviceType   String    // 'mobile' | 'desktop' | 'tablet'
  pwaInstalled Boolean   @default(false)
  installedAt  DateTime?
  pushEndpoint String?   @unique
  pushP256dh   String?
  pushAuth     String?
  lastSeenAt   DateTime  @default(now())
  userAgent    String?

  user User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case LoanCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([caseId])
}

