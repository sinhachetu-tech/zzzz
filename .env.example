DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Document storage — Cloudflare R2 (S3-compatible). Documents (KYC scans, bank
# statements, valuations) are stored in a PRIVATE bucket; the app hands the
# browser short-lived signed URLs, so files never stream through this server.
#
# The `@aws-sdk/client-s3` package is only the S3 *protocol* client that
# Cloudflare documents for R2 — storage stays 100% Cloudflare.
#
# Leave these blank to keep the legacy fallback (files inside Postgres, 4 MB
# cap) — the app works either way, so you can paste these in later.
#
# Where to find each value: Cloudflare dashboard → R2 → your bucket:
#   R2_ACCOUNT_ID        → shown on the R2 overview page (also in the S3 URL)
#   R2_ACCESS_KEY_ID     → "Manage R2 API Tokens" → Create token (Object Read & Write)
#   R2_SECRET_ACCESS_KEY → shown ONCE when the token is created — copy it then
#   R2_BUCKET            → the bucket name you created (e.g. hfmc-documents)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------------------------------------------------------------------------
# Google Drive — INDEPENDENT archive store (optional, configured in Admin →
# Storage). NOT a mirror of R2: when set, every upload is additionally copied
# into Drive under {CASE-NO — Customer}/{Category}/ folders the app creates
# automatically. Deleting a document in the app never deletes the Drive copy,
# and nothing in Drive affects the R2 bucket — you can also drop extra files
# into those folders by hand anytime.
#
# Setup (Google Cloud Console):
#   1. APIs & Services → enable "Google Drive API"
#   2. IAM & Admin → Service Accounts → Create → Keys → Add key → JSON
#      → copy "client_email" and "private_key" from the JSON file
#      (keep the \n escapes in the private key exactly as they appear)
#   3. Create a folder in Google Drive, share it with the service-account
#      email (Editor role), copy its ID from the folder URL
#
# Shared Drive vs personal My Drive:
#   • Shared Drive  — leave GOOGLE_DRIVE_IMPERSONATE blank. Add the service
#     account to the shared drive as a "Content manager" instead of sharing
#     a single folder.
#   • Personal My Drive — you MUST set GOOGLE_DRIVE_IMPERSONATE. A service
#     account has no storage quota of its own, so uploads into a personal
#     Drive fail with "storageQuotaExceeded" until it impersonates a real
#     user via domain-wide delegation:
#       Admin console → Security → API controls → Domain-wide delegation
#       → Add new → Client ID = the service account's NUMERIC ID
#       → OAuth scope = https://www.googleapis.com/auth/drive
#     Then set GOOGLE_DRIVE_IMPERSONATE to the mailbox that should own the
#     archive. Admin → Storage → "Test connection" reports which space the
#     folder actually resolved to.
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
# Only for a personal My Drive target; leave blank for a Shared Drive.
GOOGLE_DRIVE_IMPERSONATE=

